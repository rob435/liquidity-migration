# Every environment variable this repository reads, with the real default from
# the code. Nothing is loaded automatically: copy what you need into .env for
# local work. Deployed values live in root-owned, per-unit environment files
# under /etc/liquidity-migration/.
# An empty value means no committed default. Secrets are never filled in.

# =============================================================== Local development / research
# Interpreter override for scripts/dev.sh and scripts/ops.sh; empty picks .venv.
PYTHON=
# Interpreter the runner and build scripts exec.
PYTHON_BIN=.venv/bin/python
PYTHONDONTWRITEBYTECODE=1
# Base directory for research panels.
SHARED_DATA=~/SHARED_DATA
# Full-PIT research roots written by scripts/build_full_pit_{bybit,binance}.sh.
BYBIT_FULL_ROOT=~/SHARED_DATA/bybit_full_pit
BINANCE_FULL_ROOT=~/SHARED_DATA/binance_full_pit
BYBIT_START=2021-01-01
# Empty means today (UTC).
BYBIT_END=
# Perpetuals only; do not change.
BYBIT_CATEGORY=linear
BINANCE_START=2019-09-01
# Empty means today (UTC).
BINANCE_END=
# Start of the Binance daily-granularity leg; empty derives it from BINANCE_END.
BINANCE_DAILY_START=
# Bybit build concurrency.
MANIFEST_WORKERS=16
KLINE_WORKERS=8
ANCILLARY_WORKERS=4
BINANCE_WORKERS=24
BINANCE_JOB_BATCH_SIZE=48
# Abort the Binance build above this fraction of failed jobs.
BINANCE_MAX_FAILURE_RATIO=0
# Public-archive download retries and timeout.
LIQMIG_ARCHIVE_DOWNLOAD_RETRIES=5
LIQMIG_ARCHIVE_DOWNLOAD_TIMEOUT_SECONDS=300
# Empty uses urllib; "curl" shells out instead.
LIQMIG_ARCHIVE_DOWNLOAD_BACKEND=
# Vectorised 1h archive aggregation.
LIQMIG_ARCHIVE_VECTORIZE_1H=0
# JSON file of known-bad archive rows skipped during manifest builds.
LIQMIG_ARCHIVE_KLINE_SKIP_ROWS_PATH=
# scripts/research/equity_curves.sh default; research_refresh pins 8 where needed.
POLARS_MAX_THREADS=6

# ========================================================= Bybit demo runtime
# Demo credentials for api-demo.bybit.com. Never mainnet keys.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Reviewed candidate universe used by the public signal worker.
CANDIDATE_UNIVERSE_FILE=
# demo | mainnet — which fleet the liveness watchdog grades (the unit argv pins it).
ACCOUNT_LIVENESS_SCOPE=demo
# External dead-man's-switch pinged on a healthy liveness run.
LIVENESS_HEARTBEAT_URL=

# ======================================================= Mainnet runtime (funded account)
# Funded-account credentials: contract trading on, withdrawal off, IP-allowlisted.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=
# The arming switch. Demo requires false or unset; mainnet refuses without it.
REAL_MONEY=false
# The whole RM_ set is this one dial: `parse_real_money_dials` REFUSES any other
# RM_* name, so a stale line here fails the funded preflight rather than steering
# by a dial that does not exist. Omit it for the committed default.
# Venue-native disaster-stop distance armed with the CARRY entry.
RM_CARRY_STOP_LOSS_FRACTION=0.35
# ============================================================ Research LLM ledger
# Either key name enables model judgment in scripts/research/llm_driver_ledger.py.
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============================================================ Engine (Rust order path)
# The engine's own env file, one per fleet. ENGINE_CONFIG_FILE names which
# strategies run at what size, and which venue they run against; the deploy
# never rewrites it.
ENGINE_CONFIG_FILE=/etc/liquidity-migration/engine.toml
# Must be the SAME path as `heartbeat_path` in the config's [engine] block, and
# deploy verifies that agreement: the engine reads its path from the config and
# the watchdog reads it from here.
LIVENESS_ENGINE_HEARTBEAT_FILE=/var/lib/liquidity-migration-engine/heartbeat.json
RUST_LOG=info

# ================================================== Other venues (Hyperliquid, Lighter, MEXC)
# Read only by an engine whose engine.toml names that venue. Each realm reads
# its own pair and no other's, so a key left here for one venue can never
# authenticate another -- and a real-money realm still refuses to build unless
# REAL_MONEY is armed above, exactly as Bybit mainnet does.
#
# Hyperliquid. The "account" is the address orders are placed for; the key is a
# separate API WALLET (the venue calls it an agent) that the account approved
# and that cannot withdraw. Both are needed: the agent signs, the account is
# what every read is addressed to.
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET_API_WALLET_KEY=
HYPERLIQUID_REAL_ACCOUNT_ADDRESS=
HYPERLIQUID_REAL_API_WALLET_KEY=
# Lighter. The account is "<account index>:<api key index>" -- which of the
# venue's accounts, and which of its API key slots. Slots 0 and 1 belong to the
# venue's own desktop and mobile apps and are refused here: nonces are taken
# strictly in order per slot, so sharing one means one writer is always
# rejected. The secret is that slot's 40-byte private key, as hex.
LIGHTER_TESTNET_ACCOUNT=
LIGHTER_TESTNET_API_KEY_SECRET=
LIGHTER_REAL_ACCOUNT=
LIGHTER_REAL_API_KEY_SECRET=
# MEXC. One realm and it is funded: the venue publishes no testnet host for the
# futures API, so there is no practice MEXC account to point the engine at, and
# selecting mexc_mainnet needs REAL_MONEY armed like any other funded account.
# The key needs futures order-placement permission, which MEXC gates on KYC.
MEXC_REAL_API_KEY=
MEXC_REAL_API_SECRET=
# ================================================================== Sleeve toggles
# on | off. deploy/sleeves.env is the ceiling: a host override can only narrow on to off, never re-enable.
LONG_SLEEVE=on
CARRY_SLEEVE=on
# Real money has no toggle here: REAL_MONEY=true in the host's bybit-mainnet.env is the single arming switch.

# ================================================================ Notifications (Telegram)
# 1 enables Telegram delivery when the selected service also has a token and chat.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate chat for watchdog alerts; empty falls back to the main chat.
TELEGRAM_ALERT_CHAT_ID=
# Comma-separated user ids allowed to press the control buttons when the main
# chat is a group. Empty in a group chat means nobody may.
TELEGRAM_CONTROL_USER_IDS=
# Where notify_book_changes.py remembers engine position and trade-log offsets.
BOOK_NOTIFY_STATE=/var/lib/liquidity-migration/book-notify/state.json

# ================================================================== Deploy / VPS
SSH_TARGET=root@208.84.103.4
SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
REPO_URL=https://github.com/rob435/liquidity-migration.git
REPO_DIR=/opt/liquidity-migration
REMOTE=origin
BRANCH=main
# Full lowercase 40-character commit the deploy must land; empty resolves the
# current remote branch or local HEAD according to the deploy mode.
EXPECTED_COMMIT=
# Falls back to `gh auth token` for install/rollout over https.
GITHUB_TOKEN=
# install | staged | activate | verify | rollout | stop-mainnet | disarm-mainnet
DEPLOY_MODE=verify
# Host sleeve override, and the resolved file the units actually read.
LM_HOST_SLEEVES_ENV=/etc/liquidity-migration/sleeves.env
LM_RESOLVED_SLEEVES_ENV=/etc/liquidity-migration/sleeves.resolved.env
LM_SYSTEMD_UNIT_DIR=/etc/systemd/system
LM_RUNTIME_SYSTEMD_UNIT_DIR=/run/systemd/system
# Rescue-boot mount point for scripts/vps/vps_rescue_restore_ssh_access.sh.
MOUNT_ROOT=/mnt/liquidity-migration-root
# Already-mounted installed root, so the rescue script skips its own mount step.
TARGET_ROOT=
# Public keys the SSH restore scripts reinstall.
SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFwJNtc1cVhkzNKmxmq6mogten+Q/5yfLulf9wxZxMNp hetzner
GITHUB_ACTIONS_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICWcgpE3GLy65yWFuh5RAH5CEgyLqRPAGvROXGwAxmVv liquidity-migration-github-actions-20260609
# GitHub Actions workflow inputs: repository vars and secrets, not this file.
VPS_HOST=208.84.103.4
VPS_USER=root
VPS_ED25519_FINGERPRINT=SHA256:WkfDoTe+g+IfcsH/tzXkd5BiasYJliBm0n1x9raLAfs
GITHUB_ACTIONS_DEPLOY_KEY_FINGERPRINT=SHA256:Gki6YjdsUksh/TozZ/55sxSwimK7T9MOf2pgWSbqFNU
VPS_SSH_PRIVATE_KEY=
# ops.sh real-money: 1 runs preflight/render-profile against this checkout instead of the VPS.
LOCAL=0
