# Every environment variable this repository reads, with the real default from
# the code. Nothing is loaded automatically: copy what you need into .env for
# local work. The deployed copies live under /etc/liquidity-migration/, split
# per unit (bybit-demo.env, account-execution.env, bybit-mainnet.env,
# account-execution-mainnet.env, sleeves.resolved.env).
# An empty value means no committed default. Secrets are never filled in.

# =============================================================== Local development / research
# Interpreter override for scripts/dev.sh and scripts/ops.sh; empty picks .venv.
PYTHON=
# Interpreter the runner and build scripts exec.
PYTHON_BIN=.venv/bin/python
# DEBUG | INFO | WARNING | ERROR
LIQMIG_LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1
# Base directory for research panels.
SHARED_DATA=~/SHARED_DATA
# Full-PIT research roots written by scripts/build_full_pit_{bybit,binance}.sh.
BYBIT_FULL_ROOT=~/SHARED_DATA/bybit_full_pit
BINANCE_FULL_ROOT=~/SHARED_DATA/binance_full_pit
BYBIT_START=2021-01-01
# Empty means today (UTC).
BYBIT_END=
# Perpetuals only; do not change.
BYBIT_CATEGORY=linear
BINANCE_START=2019-09-01
# Empty means today (UTC).
BINANCE_END=
# Start of the Binance daily-granularity leg; empty derives it from BINANCE_END.
BINANCE_DAILY_START=
# Bybit build concurrency.
MANIFEST_WORKERS=16
KLINE_WORKERS=8
ANCILLARY_WORKERS=4
BINANCE_WORKERS=24
BINANCE_JOB_BATCH_SIZE=48
# Abort the Binance build above this fraction of failed jobs.
BINANCE_MAX_FAILURE_RATIO=0
# Public-archive download retries and timeout.
LIQMIG_ARCHIVE_DOWNLOAD_RETRIES=5
LIQMIG_ARCHIVE_DOWNLOAD_TIMEOUT_SECONDS=300
# Empty uses urllib; "curl" shells out instead.
LIQMIG_ARCHIVE_DOWNLOAD_BACKEND=
# Vectorised 1h archive aggregation.
LIQMIG_ARCHIVE_VECTORIZE_1H=0
# JSON file of known-bad archive rows skipped during manifest builds.
LIQMIG_ARCHIVE_KLINE_SKIP_ROWS_PATH=
# scripts/research/equity_curves.sh default; the deployed units pin 1 (producers) or 8.
POLARS_MAX_THREADS=6
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# =============================================== Bybit demo runtime (demo account owner + producers)
# Demo credentials for api-demo.bybit.com. Never mainnet keys.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Legacy flag: only validated as a parseable boolean, never used to pick a realm. Leave unset.
DEMO=
# Required by the demo owner and by any producer publishing demo targets.
ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
# demo | mainnet — which venue realm the private credential authenticates against.
ACCOUNT_VENUE_REALM=demo
# Derived from ACCOUNT_VENUE_REALM when unset (mainnet: bybit-mainnet-unified).
ACCOUNT_ID=bybit-demo-unified
# Canonical account journal root. Required and absolute.
ACCOUNT_EXECUTION_ROOT=/opt/liquidity-migration/data/bybit-account-execution
# Target inbox the producers write and the owner drains. Required, absolute, no committed default.
ACCOUNT_INTENT_INBOX_ROOT=
# Market/readiness capture root. Required and absolute.
ACCOUNT_CAPTURE_ROOT=/opt/liquidity-migration/data/bybit-account-market-capture
# Append-only tape of published targets; deploy sets it to <capture root>/strategy-targets.jsonl.
STRATEGY_TARGET_CAPTURE_PATH=
# Frozen candidate universe; must name the same artifact as ACCOUNT_SYMBOLS_FILE.
CANDIDATE_UNIVERSE_FILE=
ACCOUNT_SYMBOLS_FILE=/etc/liquidity-migration/account-execution/symbols.txt
# Empirical demo instrument rules frozen by demo_rule_probe.
ACCOUNT_DEMO_RULES_FILE=/etc/liquidity-migration/account-execution/demo-rules.json
# Rendered operational profile: caps, sleeve partition, leverage.
ACCOUNT_RISK_POLICY_FILE=/etc/liquidity-migration/account-execution/risk-policy.json
# Persist raw venue market messages; empty is off, the mainnet template pins 0.
ACCOUNT_RAW_MARKET_PERSISTENCE=
ACCOUNT_PRIVATE_WS_RECONNECT_SECONDS=180
# Full-position native stop used when a component declares none. Required.
DISASTER_STOP_FRACTION=0.35
# Set by systemd; readiness matches it against the running invocation.
INVOCATION_ID=
# demo | mainnet — which account owner a producer publishes targets to.
EXECUTION_ENVIRONMENT=demo
# Per-sleeve strategy root: signal inputs, caches, cycle telemetry. Not P&L authority.
DATA_ROOT=data/bybit-long-demo-event
CONFIG_PATH=configs/volume_alpha.default.yaml
# Producer cycle period.
INTERVAL_SECONDS=60
# Script default per sleeve: 100 LONG, 90 CARRY.
LOOKBACK_DAYS=100
# Script default; the deployed producer units pin 2.
WORKERS=4
# 1 runs the long-lived daemon, 0 a per-cycle subprocess.
USE_DAEMON=1
# Exit after one cycle instead of looping.
RUN_ONCE=0
# WS kline plane (every producer sleeve; REST covers gaps and funding).
WS_KLINES_ENABLED=1
# Script default; the demo units pin 2.
WS_KLINES_BOOTSTRAP_WORKERS=16
# LONG launcher default; carry sizes its store from --replay-days + 2.
WS_KLINES_LOOKBACK_DAYS=100
WS_KLINES_UNIVERSE_REFRESH_SECONDS=3600
WS_KLINES_TOPICS_PER_CONNECTION=180
WS_KLINES_STALE_WARNING_SECONDS=60
WS_KLINES_STALE_RECONNECT_SECONDS=180
# Public Bybit REST budget for the demo kline fallback, requests per second.
BYBIT_REST_RATE_LIMIT_PER_SECOND=18
# demo | mainnet — which fleet the liveness watchdog grades (the unit argv pins it).
ACCOUNT_LIVENESS_SCOPE=demo
# External dead-man's-switch pinged on a healthy liveness run.
LIVENESS_HEARTBEAT_URL=
# Demo strategy roots the liveness watchdog reads.
LONG_DEMO_DATA_ROOT=data/bybit-long-demo-event
CARRY_DEMO_DATA_ROOT=data/bybit-carry-demo-event

# ======================================================= Mainnet runtime (funded account)
# Funded-account credentials: contract trading on, withdrawal off, IP-allowlisted.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=
# The arming switch. Demo requires false or unset; mainnet refuses without it.
REAL_MONEY=false
# Real-money dials. These four are the whole set: `parse_real_money_dials`
# REFUSES any other RM_* name, so a stale line here fails the funded preflight
# rather than steering by a dial that no longer exists. Omit one for its default.
# Carry book ceiling, x equity; each name takes up to a tenth of the dial.
RM_CARRY_LEVERAGE=1.0
# LONG book ceiling, x equity, across its 10 slots.
RM_LONG_LEVERAGE=0.75
# Daily loss halt as a fraction of equity; trips a flatten.
RM_DAILY_LOSS_FRACTION=0.1
# Venue-native disaster-stop distance armed with the CARRY entry.
RM_CARRY_STOP_LOSS_FRACTION=0.35
# Mainnet strategy roots the mainnet liveness watchdog reads.
LONG_MAINNET_DATA_ROOT=data/bybit-long-mainnet-event
CARRY_MAINNET_DATA_ROOT=data/bybit-carry-mainnet-event

# ================================================================== Sleeve toggles
# on | off. deploy/sleeves.env is the ceiling: a host override can only narrow on to off, never re-enable.
LONG_SLEEVE=on
CARRY_SLEEVE=on
# Real money has no toggle here: REAL_MONEY=true in the host's bybit-mainnet.env is the single arming switch.

# ================================================================ Notifications (Telegram)
# 1 enables Telegram; the owner runners refuse to start without both values below.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================================================================== Deploy / VPS
SSH_TARGET=root@116.202.15.128
SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
REPO_URL=https://github.com/rob435/liquidity-migration.git
REPO_DIR=/opt/liquidity-migration
REMOTE=origin
BRANCH=main
# Full lowercase 40-character commit the deploy must land. Required, no default.
EXPECTED_COMMIT=
# Falls back to `gh auth token` for install/rollout over https.
GITHUB_TOKEN=
# install | activate | verify | rollout
DEPLOY_MODE=verify
# rollout only: demo-operational | operational
DEPLOY_PROFILE=
# Realm the rollout freezes venue rules against; the order-placing probe is demo-only.
DEPLOY_VENUE_REALM=demo
# Let a rollout refresh an expired demo-rule receipt instead of failing.
ROLLOUT_REFRESH_STALE_DEMO_RULES=0
# Internal remote-phase marker set by the deploy script.
RUN_PHASE_COLLECT_STATUS=0
# Settle window in scripts/maintain/reset_demo_ledgers.sh.
LEDGER_RESET_SETTLE_SECONDS=3
ACCOUNT_EXECUTION_ENV_FILE=/etc/liquidity-migration/account-execution.env
# Host sleeve override, and the resolved file the units actually read.
LM_HOST_SLEEVES_ENV=/etc/liquidity-migration/sleeves.env
LM_RESOLVED_SLEEVES_ENV=/etc/liquidity-migration/sleeves.resolved.env
LM_SYSTEMD_UNIT_DIR=/etc/systemd/system
LM_RUNTIME_SYSTEMD_UNIT_DIR=/run/systemd/system
SYSTEMCTL_BIN=/usr/bin/systemctl
# Rescue-boot mount point for scripts/vps/vps_rescue_restore_ssh_access.sh.
MOUNT_ROOT=/mnt/liquidity-migration-root
# Already-mounted installed root, so the rescue script skips its own mount step.
TARGET_ROOT=
# Public keys the SSH restore scripts reinstall.
SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFwJNtc1cVhkzNKmxmq6mogten+Q/5yfLulf9wxZxMNp hetzner
GITHUB_ACTIONS_SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICWcgpE3GLy65yWFuh5RAH5CEgyLqRPAGvROXGwAxmVv liquidity-migration-github-actions-20260609
# GitHub Actions workflow inputs: repository vars and secrets, not this file.
VPS_HOST=116.202.15.128
VPS_USER=root
VPS_ED25519_FINGERPRINT=SHA256:TJRbvgB8nfhwmNDv4hM3jDkPXnRv6BGLQ3cPst2PfE4
GITHUB_ACTIONS_DEPLOY_KEY_FINGERPRINT=SHA256:Gki6YjdsUksh/TozZ/55sxSwimK7T9MOf2pgWSbqFNU
VPS_SSH_PRIVATE_KEY=
# ops.sh real-money: 1 runs preflight/render-profile against this checkout instead of the VPS.
LOCAL=0
