# /etc/liquidity-migration/signal-worker-hyperliquid-source.env -- root-owned, 0600
#
# Reviewed public inputs copied into the unprivileged Rust signal worker that
# feeds the Hyperliquid account owner. This file contains no venue credentials;
# the public data is Hyperliquid's own (`sources.public_venue` in
# configs/signal-worker.hyperliquid.json).

SIGNAL_WORKER_REALM=hyperliquid
OPERATIONAL_PROFILE_FILE=/etc/liquidity-migration/signal-worker-hyperliquid-source/operational-profile.json
