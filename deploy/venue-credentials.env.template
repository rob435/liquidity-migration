# /etc/liquidity-migration/<venue>-<realm>.env  --  root-owned, mode 0600
#
# Credentials for a venue other than Bybit. Copy the block you need into its own
# file on the host and edit it there; no deploy writes these.
#
# ONE FILE PER REALM, and name the file after the realm it holds. An engine
# unit loads exactly one credential file, so a file holding two realms' keys is
# a host where the wrong one can be picked up.
#
# A FILE ALONE IS NOT ENOUGH. The two engine units that exist —
# `liquidity-migration-engine.service` and
# `liquidity-migration-engine-mainnet.service` — each name a Bybit credential
# file by hand:
#
#   EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
#   EnvironmentFile=/etc/liquidity-migration/bybit-mainnet.env
#
# So running a venue from this template means a unit for it, with its own
# `EnvironmentFile` line, its own `engine.toml`, its own state directory and
# its own lease. Writing the file and changing `venue` in an existing unit's
# config gets a credential read that fails, because the variables were never
# in that unit's environment. Choosing the unit topology is the owner's.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.
#
# ---------------------------------------------------------------------------
# What the engine does with these
# ---------------------------------------------------------------------------
# `venue` in engine.toml names a venue AND a realm; that name is what decides
# which pair below is read. The pairs are disjoint across every realm of every
# venue, so a key left on the host for one can never authenticate another.
#
# REAL_MONEY is the single arming switch, and it is the same one Bybit uses. A
# real-money realm refuses to build without it; a practice realm refuses to
# build WITH it, so a host cannot be half-live and half-practice. It belongs in
# the credential file the owner edits by hand, never in a deploy.
# Arming is necessary, not sufficient: `engine venues` shows the reviewed
# evidence gate. Hyperliquid, Lighter, and MEXC mainnets plus both Binance
# realms ship `production-blocked`, so `engine run` refuses them before reading
# this file.


# ---------------------------------------------------------------------------
# Hyperliquid
# ---------------------------------------------------------------------------
# The account address is the account orders are placed for and every read is
# addressed to. The wallet key is a separate API WALLET (the venue calls it an
# agent) that the account owner approved in the venue's own interface; it can
# place and cancel orders and CANNOT withdraw, so the key on this host is not a
# key to the funds.
#
# The engine checks at boot that the key signs as an address the account has
# approved, and refuses to start if it does not — every order it sent would be
# rejected, and finding that out per order is worse than at the door.
#
# Testnet:
# HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=0x...
# HYPERLIQUID_TESTNET_API_WALLET_KEY=0x...
#
# Mainnet (REAL MONEY; production-blocked even with REAL_MONEY=true):
# HYPERLIQUID_REAL_ACCOUNT_ADDRESS=0x...
# HYPERLIQUID_REAL_API_WALLET_KEY=0x...


# ---------------------------------------------------------------------------
# Lighter
# ---------------------------------------------------------------------------
# The account is "<account index>:<api key index>". The key index must be
# between 2 and 254: slot 0 belongs to the venue's desktop client and slot 1 to
# its mobile one. That is not a style rule — the venue takes each slot's
# transaction nonces strictly in order, so an engine sharing a slot with a
# human's app means one of the two is always refused.
#
# The secret is that slot's private key: 40 bytes as hex, with or without a
# leading 0x. Register the matching public key against the slot in the venue's
# own interface first; `engine venue-key` prints the public key this host would
# sign with.
#
# Testnet:
# LIGHTER_TESTNET_ACCOUNT=12345:2
# LIGHTER_TESTNET_API_KEY_SECRET=...
#
# Mainnet (REAL MONEY; production-blocked even with REAL_MONEY=true):
# LIGHTER_REAL_ACCOUNT=12345:2
# LIGHTER_REAL_API_KEY_SECRET=...


# ---------------------------------------------------------------------------
# MEXC
# ---------------------------------------------------------------------------
# MEXC publishes no futures testnet endpoint. This pair always reaches mainnet,
# every order is real. The adapter has offline test evidence only and
# `engine run` keeps this realm production-blocked; see docs/engine.md before
# provisioning it. REAL_MONEY=true cannot override that source gate.
#
# Mainnet:
# MEXC_REAL_API_KEY=...
# MEXC_REAL_API_SECRET=...


# ---------------------------------------------------------------------------
# Binance USD-M futures
# ---------------------------------------------------------------------------
# Binance identifies the account from the authenticated key; there is no
# account-id variable to copy. Testnet publishes the private order and Algo
# Service streams used by the adapter, but no signed run has proved the
# flat-entry and protective-stop lifecycle. Both realms stay
# production-blocked; REAL_MONEY=true cannot override that source gate.
#
# Testnet (production-blocked pending the signed stop lifecycle):
# BINANCE_TESTNET_API_KEY=...
# BINANCE_TESTNET_API_SECRET=...
#
# Mainnet (REAL MONEY; production-blocked even with REAL_MONEY=true):
# BINANCE_REAL_API_KEY=...
# BINANCE_REAL_API_SECRET=...


# ---------------------------------------------------------------------------
# Variational
# ---------------------------------------------------------------------------
# Nothing to fill in. The venue publishes market statistics and no trading API,
# so an engine pointed at it needs no credential — it reads the market and
# refuses every order. These names exist so the shape matches the other three
# when a trading API arrives.
#
# VARIATIONAL_REAL_API_KEY=
# VARIATIONAL_REAL_API_SECRET=


# ---------------------------------------------------------------------------
# The arming switch
# ---------------------------------------------------------------------------
# Uncomment ONLY in a file holding real-money credentials, and only by the
# account owner's own hand. No deploy, and no commit, may ever set this.
#
# REAL_MONEY=true
