# /etc/liquidity-migration/mexc-mainnet.env  --  root-owned, mode 0600
#
# THE MEXC EXECUTION FILE YOU EDIT. Copy it to the path above on the VPS, fill
# in the credentials, and run:
#
#     scripts/ops.sh real-money preflight-mexc
#
# which tells you exactly what is still missing.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.
#
# ---------------------------------------------------------------------------
# 1. Credentials and the arming switch
# ---------------------------------------------------------------------------
# MEXC PUBLISHES NO FUTURES TESTNET. There is no practice account to point this
# at: every order this key can place is real, from the first one.
#
# Create the key on the MEXC account with:
#   * futures order placement enabled — MEXC gates that permission on KYC,
#   * withdrawal disabled,
#   * IP-allowlisted to this VPS.
MEXC_REAL_API_KEY=
MEXC_REAL_API_SECRET=

# The arming switch. Until this is exactly true the MEXC client refuses to
# construct, the owner runner refuses to start, and deploy leaves every mexc
# unit stopped. It is set by the owner's hand; deploy only ever rewrites it
# atomically to false during `scripts/ops.sh deploy disarm-mexc`.
REAL_MONEY=false

# ---------------------------------------------------------------------------
# 2. No dials here
# ---------------------------------------------------------------------------
# The RM_ operational dials live in /etc/liquidity-migration/bybit-mainnet.env
# and are rendered once into one operational profile whose identical bytes land
# in every realm's signal-worker source directory, this realm included. A dial
# set in this file is read by nothing.

# ---------------------------------------------------------------------------
# 3. Notifications (optional)
# ---------------------------------------------------------------------------
# Rollout projects these values into a notification-only file for the mexc
# liveness observer. Left empty, it falls back to the demo Telegram pair. The
# engine removes them from its own environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate chat for watchdog alerts; empty falls back to the main chat.
TELEGRAM_ALERT_CHAT_ID=
