# Repository ceiling for publishers. Host overrides may only turn an `on` value
# off. Turning a sleeve off stops publication; it does not zero targets or
# flatten exposure. Flatten through the account owner and verify venue/journal
# state before retirement. Strict KEY=value; accepted values are on/off.
LONG_SLEEVE=on
CONTINUOUS_SLEEVE=off
CONTINUOUS_PAPER_SLEEVE=off
CARRY_SLEEVE=on
CARRY_PAPER_SLEEVE=on
# Real-money producers. Off in the repository, which is a hard ceiling: a host
# override can only narrow an enabled sleeve, never re-enable a disabled one,
# so turning either of these on is a committed change and not a host edit.
# Turning them on is still not sufficient -- REAL_MONEY, mainnet credentials,
# and a real-money authority receipt are separate owner acts.
CARRY_MAINNET_SLEEVE=off
LONG_MAINNET_SLEEVE=off
