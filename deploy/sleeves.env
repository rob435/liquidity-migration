# Repository ceiling for publishers. Host overrides may only turn an `on` value
# off. Turning a sleeve off stops publication; it does not zero targets or
# flatten exposure -- the last targets stay standing in the journal. Use
# `scripts/ops.sh flatten --execute --environment demo --reason ...` after the
# sleeve is off. Strict KEY=value; accepted values are on/off.
LONG_SLEEVE=on
CONTINUOUS_SLEEVE=off
CONTINUOUS_PAPER_SLEEVE=off
CARRY_SLEEVE=on
# Superseded by PAPER_TARGET_MIRROR. An independent paper CARRY producer races
# the demo producer's data store and diverges from its book; turning this on
# reinstates that race.
CARRY_PAPER_SLEEVE=off
# Republishes the demo fleet's published targets onto the paper route, so the
# only remaining difference between the two books is execution.
#
# On since 2026-07-31. It was off before that for a reason that was wrong:
# the unit was calling ensure_account_route, an owner-side initializer that
# requires the manifests to belong to the running process. The mirror is not an
# owner and runs privileged on purpose, so it now uses require_account_route
# with the paper owner's uid named explicitly -- the read that function already
# documents for a privileged observer. No boundary was widened; the tape stays
# 0600 root-only.
PAPER_TARGET_MIRROR=on
# Real-money producers. Repo-off is a hard ceiling: a host override can only
# narrow, so turning either on takes a committed change. That alone arms
# nothing: REAL_MONEY and the mainnet credentials must be in
# /etc/liquidity-migration/bybit-mainnet.env, and
# `scripts/ops.sh real-money preflight` must pass.
CARRY_MAINNET_SLEEVE=off
LONG_MAINNET_SLEEVE=off
