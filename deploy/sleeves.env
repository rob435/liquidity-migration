# Repository ceiling for publishers. Strict KEY=value; accepted values are
# on/off. A host override may only turn an `on` value off. Turning a sleeve off
# stops publication and leaves the last targets standing -- flatten separately.
# Details: docs/operations.md.
LONG_SLEEVE=on
CONTINUOUS_SLEEVE=off
CONTINUOUS_PAPER_SLEEVE=off
CARRY_SLEEVE=on
# Superseded by PAPER_TARGET_MIRROR; an independent paper CARRY producer races
# the demo producer's data store.
CARRY_PAPER_SLEEVE=off
# Republishes the demo fleet's targets onto the paper route, so the only
# remaining difference between the two books is execution.
PAPER_TARGET_MIRROR=on
# Real-money producers. Repo-off is a hard ceiling: turning either on takes a
# committed change, and even then REAL_MONEY, the mainnet credentials, and
# `scripts/ops.sh real-money preflight` are all still the owner's own acts.
CARRY_MAINNET_SLEEVE=off
LONG_MAINNET_SLEEVE=off
