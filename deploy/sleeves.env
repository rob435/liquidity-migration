# Repository ceiling for publishers. Host overrides may only turn an `on` value
# off. Turning a sleeve off stops publication; it does not zero targets or
# flatten exposure. Flatten through the account owner and verify venue/journal
# state before retirement. Strict KEY=value; accepted values are on/off.
LONG_SLEEVE=on
CONTINUOUS_SLEEVE=off
CONTINUOUS_PAPER_SLEEVE=off
CARRY_SLEEVE=on
CARRY_PAPER_SLEEVE=on
