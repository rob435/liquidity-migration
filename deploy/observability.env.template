# /etc/liquidity-migration/observability.env  --  root-owned, mode 0640,
# group liquidity-migration (the equity recorder reads it as the observer user)
#
# Where the minute sampler pushes a copy of what it has already written to
# disk. Absent, empty, or partly filled means local files only, which is a
# supported configuration: the JSONL under /var/lib/liquidity-migration/equity
# is the record, and this is a view of it.
#
# Format: strict KEY=value, one per line, no quotes, no inline comments.
# systemd reads it verbatim, and the token must never appear anywhere else.
#
# Set up: docs/observability.md.

# The sink's InfluxDB line-protocol write endpoint. For Grafana Cloud this is
# the "Influx" URL on the stack's Metrics page and ends in
# /api/v1/push/influx/write. Any endpoint that speaks line protocol works.
METRICS_PUSH_URL=

# HTTP basic auth. For Grafana Cloud the user is the numeric instance ID next
# to that URL, and the password is an Access Policy token with metrics:write.
METRICS_PUSH_USER=
METRICS_PUSH_TOKEN=
