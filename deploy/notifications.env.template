# /etc/liquidity-migration/notifications.env -- root:root, mode 0600
#
# Telegram transport only. Trading services never load this file, and
# notification services never load venue credential files.
# Format: strict KEY=value, one per line, no quotes or inline comments.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=

# Optional in a private owner chat. Required in a group: comma-separated
# numeric Telegram user ids allowed to press control buttons.
TELEGRAM_CONTROL_USER_IDS=
