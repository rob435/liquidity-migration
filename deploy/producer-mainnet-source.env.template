# /etc/liquidity-migration/producer-mainnet-source.env -- root-owned, 0600
#
# Inputs copied into the unprivileged funded producer environment. This file
# contains no venue credentials.

PRODUCER_REALM=mainnet
CANDIDATE_UNIVERSE_FILE=/etc/liquidity-migration/producer-mainnet-source/candidate-universe.json
VENUE_RULES_FILE=/etc/liquidity-migration/producer-mainnet-source/venue-rules.json
OPERATIONAL_PROFILE_FILE=/etc/liquidity-migration/producer-mainnet-source/operational-profile.json

# Each new entry is the strategy base slot times this multiplier. The LONG
# producer applies its own volatility and weekend scaling after this value.
CARRY_NOTIONAL_MULTIPLIER=3.0
LONG_NOTIONAL_MULTIPLIER=6.0
EXODUS_NOTIONAL_MULTIPLIER=3.0
