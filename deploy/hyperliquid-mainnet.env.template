# /etc/liquidity-migration/hyperliquid-mainnet.env  --  root-owned, mode 0600
#
# THE HYPERLIQUID EXECUTION FILE YOU EDIT. Copy it to the path above on the
# VPS, fill in the credentials, and run:
#
#     scripts/ops.sh real-money preflight-hyperliquid
#
# which tells you exactly what is still missing.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.
#
# ---------------------------------------------------------------------------
# 1. Credentials and the arming switch
# ---------------------------------------------------------------------------
# Hyperliquid publishes a testnet, but the fleet's `hyperliquid` realm is the
# FUNDED MAINNET ACCOUNT ONLY. There is no fleet realm for the testnet: every
# order this file can authorise is real.
#
# The address is the master account orders are placed for and every read is
# addressed to. Lowercase `0x` plus 40 hex characters.
HYPERLIQUID_REAL_ACCOUNT_ADDRESS=
# The key is a separate API WALLET (the venue calls it an agent), approved by
# the account above in the venue's own interface. `0x` plus 64 hex characters.
# It can place and cancel orders and CANNOT withdraw, so this host never holds
# a key to the funds. Never put the account's own wallet key here.
HYPERLIQUID_REAL_API_WALLET_KEY=

# The arming switch. Until this is exactly true the Hyperliquid client refuses
# to construct, the owner runner refuses to start, and deploy leaves every
# hyperliquid unit stopped. It is set by the owner's hand; deploy only ever
# rewrites it atomically to false during
# `scripts/ops.sh deploy disarm-hyperliquid`.
REAL_MONEY=false

# ---------------------------------------------------------------------------
# 2. No dials here
# ---------------------------------------------------------------------------
# The RM_ operational dials live in /etc/liquidity-migration/bybit-mainnet.env
# and are rendered once into one operational profile whose identical bytes land
# in every realm's signal-worker source directory, this realm included. A dial
# set in this file is read by nothing.

# ---------------------------------------------------------------------------
# 3. Notifications (optional)
# ---------------------------------------------------------------------------
# Rollout projects these values into a notification-only file for the
# hyperliquid liveness observer. Left empty, it falls back to the demo Telegram
# pair. The engine removes them from its own environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate chat for watchdog alerts; empty falls back to the main chat.
TELEGRAM_ALERT_CHAT_ID=
