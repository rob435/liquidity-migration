{
  "title": "liquidity-migration fleet",
  "uid": "liqmig-fleet",
  "description": "The funded and demo engines, signal workers, and tape recorders, sampled once a minute by scripts/runtime/record_equity.py. The JSONL under /var/lib/liquidity-migration/equity on the host is the record; this is a view. Rendered by deploy/grafana/render_dashboard.py.",
  "tags": [
    "liquidity-migration"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-proudtortoise1017-prom",
          "value": "grafanacloud-prom"
        },
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "realm",
        "label": "Realm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_METRICS}"
        },
        "query": "label_values(lm_engine_up, realm)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Engines",
      "description": "Current engine heartbeat state for each selected realm. Red means the minute sampler could not read a live engine heartbeat.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_up{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "New orders",
      "description": "The effective account-level entry gate. Paused engines may still reduce or close exposure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PAUSED",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "OPEN",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_may_open{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Signal workers",
      "description": "The worker verdict and ticker coverage. Starting and bounded recovery count as healthy; a coverage miss remains visible beside the verdict.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ATTENTION",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_worker_status_healthy{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}} verdict",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_worker_ticker_coverage_complete{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}} coverage",
          "range": false,
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Tape recorders",
      "description": "The minute sampler can read each recorder's current status file. Detailed capacity and gap signals are below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
