          "legendFormat": "{{realm}} fills",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "increase(lm_engine_stream_resets{realm=~\"$realm\"}[15m])",
          "instant": false,
          "legendFormat": "{{realm}} stream resets",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Order-path latency \u00b7 p99",
      "description": "Measured order-path windows only. The emphasized end-to-end line contains decision, durability, dispatch, venue work, and the return to the strategy core.",
