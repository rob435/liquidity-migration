{
  "title": "liquidity-migration fleet",
  "uid": "liqmig-fleet",
  "description": "The funded and demo engines and the tape recorders, sampled once a minute by scripts/runtime/record_equity.py. The JSONL under /var/lib/liquidity-migration/equity on the host is the record; this is a view. Rendered by deploy/grafana/render_dashboard.py.",
  "tags": [
    "liquidity-migration"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_METRICS",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "realm",
        "label": "Realm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_METRICS}"
        },
        "query": "label_values(lm_engine_up, realm)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "state-timeline",
      "id": 1,
      "title": "Health",
      "description": "One lane per fact, sampled every minute. Green is the good state: a readable heartbeat, may_open true, the 24h loss breaker not tripped, a live recorder. A red minute is a real minute: the sampler writes the line whether or not the engine is up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT ok",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ok",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_up{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} \u00b7 engine heartbeat",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_may_open{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} \u00b7 may open",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "1 - lm_engine_rolling_loss_tripped{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} \u00b7 loss breaker clear",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_recorder_up",
          "instant": false,
          "legendFormat": "recorder {{realm}} \u00b7 live",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Equity",
      "description": "Mark to market from the venue's own account reading, as the heartbeat carries it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD",
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_equity_usdt{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Account",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Equity and available margin",
      "description": "Sampled once a minute from the heartbeat. A gap is a minute with no live heartbeat. Available under equity is margin posted against open positions; negative available is normal while the owner holds hand positions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": null
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_equity_usdt{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} equity",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_available_usdt{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} available",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Rolling 24h loss against its ceiling",
      "description": "Net realized loss in the trailing 24 hours next to the breaker's limit. Touching the limit trips the breaker: every sleeve shows entries_enabled false until it clears.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": null
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_rolling_loss_net_usdt{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} net",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_rolling_loss_limit_usdt{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} limit",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Sleeves",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Open positions by sleeve",
      "description": "How many positions each configured sleeve holds, zero included, so a flat sleeve is a line at zero rather than a missing one. `unattributed` is exposure no sleeve owns: the owner's hand trades.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "label_replace({__name__=~\"lm_engine_sleeve_.*_positions\", realm=~\"$realm\"}, \"sleeve\", \"$1\", \"__name__\", \"lm_engine_sleeve_(.*)_positions\")",
          "instant": false,
          "legendFormat": "{{realm}} {{sleeve}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "state-timeline",
      "id": 22,
      "title": "Entries enabled by sleeve",
      "description": "The effective entry gate per sleeve after committed config and the newest durable runtime override. Off means the sleeve may exit and settle but not open or grow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "on",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "label_replace({__name__=~\"lm_engine_sleeve_.*_entries_enabled\", realm=~\"$realm\"}, \"sleeve\", \"$1\", \"__name__\", \"lm_engine_sleeve_(.*)_entries_enabled\")",
          "instant": false,
          "legendFormat": "{{realm}} {{sleeve}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Entry blockers by sleeve",
      "description": "Per-symbol reasons a sleeve is not opening right now, counted per sleeve. Expected trading state (inside a resize band, entry window closed), not faults; faults are strategy errors below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "label_replace({__name__=~\"lm_engine_sleeve_.*_blockers\", realm=~\"$realm\"}, \"sleeve\", \"$1\", \"__name__\", \"lm_engine_sleeve_(.*)_blockers\")",
          "instant": false,
          "legendFormat": "{{realm}} {{sleeve}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Order path",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 31,
      "title": "Order path last measured",
      "description": "How long since the engine's latency ledger last held an order. The ledger is a 60-second window: it is only populated in a minute an order went out. The demo probe rests one order every 15 minutes, so demo should never read above about 16 minutes; mainnet reads the time since the funded engine last sent anything.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1200
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "time() - timestamp(last_over_time(lm_engine_end_to_end_p50_ns{realm=~\"$realm\"}[30d]))",
          "instant": true,
          "legendFormat": "{{realm}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 32,
      "title": "Orders sent since boot",
      "description": "The engine's own since-boot counter. It resets to zero on every restart, so read it next to uptime.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_orders_sent{realm=~\"$realm\"}",
          "instant": true,
          "legendFormat": "{{realm}}",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "Order path, end to end",
      "description": "From the strategy's decision to the venue's acknowledgement, p50 and p99 over the ledger's 60-second window. Plotted as points: there is a value only in a minute an order went out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ns",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_end_to_end_p50_ns{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_end_to_end_p99_ns{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} p99",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 34,
      "title": "Order path by step, p99",
      "description": "Where the time goes. decide is the strategy; durable is the log barrier; wire is encode and send; ack is the venue's round trip; dispatch queue, venue task and core resume are the hand-offs between them. barrier wait is what the order actually waited on the disk; quota hold is time the adapter held a command back to stay inside the venue's request quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ns",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_decide_p99_ns{realm=~\"$realm\"}",
          "instant": false,
          "legendFormat": "{{realm}} decide",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_durable_p99_ns{realm=~\"$realm\"}",
