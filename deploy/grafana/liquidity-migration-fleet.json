        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 10,
        "y": 14,
        "w": 14,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/end-to-end/"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 4
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
