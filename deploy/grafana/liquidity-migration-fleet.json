    {
      "type": "row",
      "id": 30,
      "title": "Execution",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Execution activity \u00b7 15m",
      "description": "New orders, fills, and recovered private-stream resets in each 15-minute window. Since-boot counters are read as increases so a restart does not draw a false cliff.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "increase(lm_engine_orders_sent{realm=~\"$realm\"}[15m])",
          "instant": false,
          "legendFormat": "{{realm}} orders",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "increase(lm_engine_fills{realm=~\"$realm\"}[15m])",
