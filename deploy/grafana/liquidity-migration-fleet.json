          },
          "editorMode": "code",
          "expr": "lm_engine_end_to_end_p99_ns{realm=~\"$realm\"} / 1000000",
          "instant": false,
          "legendFormat": "{{realm}} \u00b7 end-to-end",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
