        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_METRICS}"
          },
          "editorMode": "code",
          "expr": "lm_engine_decide_p99_ns{realm=~\"$realm\"} / 1000000",
          "instant": false,
          "legendFormat": "{{realm}} \u00b7 decide",
          "range": true,
          "refId": "D"
