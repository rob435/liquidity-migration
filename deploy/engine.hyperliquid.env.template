# /etc/liquidity-migration/engine-hyperliquid.env  --  root-owned, mode 0600
#
# Unit settings for the Rust execution engine on the Hyperliquid account. Copy
# this file to the path above on the VPS and edit it there; no deploy writes it.
#
# The credentials are NOT here. They are in
# /etc/liquidity-migration/hyperliquid-mainnet.env, along with REAL_MONEY, and
# that file is the owner's — nothing in this repository writes it, and without
# REAL_MONEY=true in it the engine refuses to build a Hyperliquid gateway at
# all.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.

# ---------------------------------------------------------------------------
# 1. The engine's config
# ---------------------------------------------------------------------------
# Ordered native strategies, account limits, WAL paths, and the compiled-in
# Hyperliquid adapter. Rollout renders and checks this file from registered
# rules and the installed operational profile.
ENGINE_CONFIG_FILE=/etc/liquidity-migration/engine-hyperliquid.toml

# Required identity binding. On Hyperliquid the account id is the master
# account's own address, lowercase `0x` plus 40 hex characters — not the API
# wallet's address.
# `engine verify-account-identity --config /etc/liquidity-migration/engine-hyperliquid.toml`
# prints the exact string this must equal. The `0x` below is a deliberate
# placeholder: it mismatches every account, so activation refuses until the
# owner pastes what that command printed.
EXPECTED_ENGINE_ACCOUNT_USER_ID=0x
EXPECTED_ENGINE_VENUE=hyperliquid
# The venue name carries the realm: `hyperliquid_mainnet` is the only
# Hyperliquid realm the fleet runs, and it is the string the heartbeat and the
# account lease are named by.
EXPECTED_ENGINE_REALM=hyperliquid_mainnet

# ---------------------------------------------------------------------------
# 2. Being watched
# ---------------------------------------------------------------------------
# The fleet's watchdog (check_fleet_liveness.py) reads the heartbeat file and
# pages when it goes stale, cannot be read, or says the engine has stopped
# opening positions.
#
# THIS MUST BE THE SAME PATH as `heartbeat_path` in the [engine] block of the
# config, and nothing checks that for you: the engine reads its path from the
# config, the watchdog reads it from here. Two different paths means the engine
# writes a file nobody reads and the watchdog pages about a file nobody writes.
LIVENESS_ENGINE_HEARTBEAT_FILE=/var/lib/liquidity-migration-engine-hyperliquid/heartbeat.json

# ---------------------------------------------------------------------------
# 3. How much it says (optional)
# ---------------------------------------------------------------------------
# Unset means info. Everything the engine prints goes to the journal, which is
# capped at 500M by the deploy — a debug level on a busy market fills that in
# hours and pushes out the fleet's own logs.
RUST_LOG=info
