# /etc/liquidity-migration/account-execution-mainnet.env -- root-owned, 0600
#
# Route and input paths for the mainnet account owner. You normally do not edit
# this: `scripts/ops.sh real-money preflight` checks it and the arming runbook
# in docs/operations.md installs it. It is here so every path the mainnet owner
# reads is visible in one place.
#
# Every root is disjoint from the demo and paper roots. The realm is baked into
# the durable on-disk route identity and the owner refuses to rewrite an
# existing one, so there is no migration path from the demo journal.

ACCOUNT_VENUE_REALM=mainnet
ACCOUNT_RAW_MARKET_PERSISTENCE=0


# The frozen candidate universe, read from the MAINNET endpoint. Must be the
# same file as ACCOUNT_SYMBOLS_FILE.
CANDIDATE_UNIVERSE_FILE=/etc/liquidity-migration/account-execution-mainnet/candidate-universe.json
ACCOUNT_SYMBOLS_FILE=/etc/liquidity-migration/account-execution-mainnet/candidate-universe.json

# Instrument rules from the read-only get_instruments_info endpoint. The name is
# realm-neutral by convention only — the loader refuses an artifact frozen
# against the other realm.
ACCOUNT_DEMO_RULES_FILE=/etc/liquidity-migration/account-execution-mainnet/venue-rules.json

# The rendered operational profile. Changing RM_CARRY_STOP_LOSS_FRACTION in
# bybit-mainnet.env means re-rendering this file and reinstalling.
ACCOUNT_RISK_POLICY_FILE=/etc/liquidity-migration/account-execution-mainnet/risk-policy.json

# Explicit full-position native stop used when a component declares none.
DISASTER_STOP_FRACTION=0.35

# Sizing: one multiplier per strategy, and that is the whole bank. Each new
# entry = the strategy's base slot (at most 10% of equity) x this number; LONG's
# own vol/weekend scaling (up to ~1.9x) then applies on top of its line. Omit a
# line and the committed profile's value applies.
#
# They live HERE and not in bybit-mainnet.env because the funded producer units
# never load the file holding the key. Editing them takes a restart of the two
# mainnet producer units, not a profile re-render: the producers read these
# names out of their own environment.
CARRY_NOTIONAL_MULTIPLIER=3.0
LONG_NOTIONAL_MULTIPLIER=6.0
EXODUS_NOTIONAL_MULTIPLIER=3.0
