# /etc/liquidity-migration/engine-mainnet.env  --  root-owned, mode 0600
#
# Unit settings for the Rust execution engine on the FUNDED account. Copy this
# file to the path above on the VPS and edit it there; no deploy writes it.
#
# The credentials are NOT here. They are in
# /etc/liquidity-migration/bybit-mainnet.env, along with REAL_MONEY, and that
# file is the owner's — nothing in this repository writes it, and without
# REAL_MONEY=true in it the engine refuses to build a mainnet gateway at all.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.

# ---------------------------------------------------------------------------
# 1. The engine's config
# ---------------------------------------------------------------------------
# Which sleeves run, whose books they follow, and where the capital limits come
# from. deploy/engine.mainnet.toml.template is the copy to fill in.
ENGINE_CONFIG_FILE=/etc/liquidity-migration/engine-mainnet.toml

# ---------------------------------------------------------------------------
# 2. Shadow or live
# ---------------------------------------------------------------------------
# Shadow computes and logs orders and sends nothing.
#
# LEAVE THIS FALSE until a shadow run against this account has been watched.
# Nothing in this engine has ever carried an order on the funded account; the
# whole mainnet path is tested and fenced and unexercised, and the only thing
# that turns that from a claim into a fact is watching it.
#
# The flag can only turn shadow OFF, never on. If the config says
# `shadow = false`, the engine is live whatever this line says. Shadow needs
# BOTH: `shadow = true` in the config and this false.
#
# A live engine also takes the account's single-writer lease, which a shadow
# one only looks at. So a live engine on an account something else is already
# trading refuses to start rather than fighting it. The unit carries no
# `Conflicts=` line, deliberately: the lease is the check, not systemd.
#
# Accepted for on: 1, true, yes, on (any capitalisation).
ENGINE_LIVE=false

# ---------------------------------------------------------------------------
# 3. Being watched
# ---------------------------------------------------------------------------
# The fleet's watchdog (check_fleet_liveness.py, every three minutes) reads the
# heartbeat file and pages when it goes stale, cannot be read, or says the
# engine has stopped opening positions.
#
# THIS MUST BE THE SAME PATH as `heartbeat_path` in the [engine] block of the
# config, and nothing checks that for you: the engine reads its path from the
# config, the watchdog reads it from here. Two different paths means the engine
# writes a file nobody reads and the watchdog pages about a file nobody writes.
#
# Note this is a different file from the demo engine's. Two engines on two
# accounts writing one heartbeat would each overwrite the other's, and the
# watchdog would report whichever wrote last as if it were both.
LIVENESS_ENGINE_HEARTBEAT_FILE=/var/lib/liquidity-migration-engine-mainnet/heartbeat.json

# ---------------------------------------------------------------------------
# 4. How much it says (optional)
# ---------------------------------------------------------------------------
# Unset means info. Everything the engine prints goes to the journal, which is
# capped at 500M by the deploy — a debug level on a busy market fills that in
# hours and pushes out the fleet's own logs.
RUST_LOG=info
