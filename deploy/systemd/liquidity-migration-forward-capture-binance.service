[Unit]
Description=Binance USD-M market recorder: books, trades, mark and index, funding, liquidations, and instrument snapshots
Wants=network-online.target
After=network-online.target
# Never gives up: the recorder is meant to run for months, and a venue outage
# must not park it in the failed state.
StartLimitIntervalSec=0

[Service]
Type=simple
User=liquidity-capture
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=PYTHONDONTWRITEBYTECODE=1
# The tiers, feeds, and retention are the config file; the recorder itself is
# the market_tape package.
ExecStart=/opt/liquidity-migration/.venv/bin/python -m market_tape record \
    --config deploy/capture/binance-usdm.toml \
    --root /var/lib/liquidity-migration/forward-market-binance
# 143 is a clean SIGTERM stop.
SuccessExitStatus=143
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=90

StateDirectory=liquidity-migration/forward-market-binance
StateDirectoryMode=0750
ReadWritePaths=/var/lib/liquidity-migration/forward-market-binance
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
# systemd counts the page cache of the files this process writes against the
# cap, and the recorder writes several gigabytes a day.
MemoryMax=1G
LimitNOFILE=65536
TasksMax=256
Nice=12
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
