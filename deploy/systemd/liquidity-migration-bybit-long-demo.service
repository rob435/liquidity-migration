[Unit]
Description=liquidity-migration LONG demo target producer (LongV12WideStop)
Wants=network-online.target
# Wants=, not Requires=: a dead owner must not take the producers down with it.
# Producers re-check owner health per cycle and plan entries as blocked while
# still publishing exits, so a degraded fleet keeps draining risk.
Wants=liquidity-migration-account-execution.service
After=network-online.target liquidity-migration-account-execution.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=DATA_ROOT=data/bybit-long-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=demo
Environment=TELEGRAM_ENABLED=0
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The 90-day turnover rank requires at least 95 days after bar trimming.
Environment=LOOKBACK_DAYS=100
Environment=WORKERS=2
Environment=WS_KLINES_ENABLED=1
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
# Registered LONG profile (change point 2026-08-03): v12 = v11a with the stop
# opened to 3x ATR at entry, decayed to 1.5x after 48h by producer-planned
# exits. Standing v11a components keep their published terms and drain under
# the same planner.
Environment=LONG_STRATEGY_PROFILE=v12
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-bybit-long-demo.service main
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=90
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027
ReadWritePaths=/opt/liquidity-migration
MemoryHigh=576M
MemoryMax=640M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
