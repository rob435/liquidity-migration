[Unit]
Description=liquidity-migration LONG demo target producer (LongV12WideStop)
Wants=network-online.target
# This producer writes a target book; the Rust engine reads it and owns the
# venue account. There is no process-ordering edge between them.
After=network-online.target

[Service]
Type=simple
User=liquidity-producer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/producer-demo.env
EnvironmentFile=/etc/liquidity-migration/engine.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=DATA_ROOT=data/bybit-long-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=demo
Environment=TELEGRAM_ENABLED=0
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The 90-day turnover rank requires at least 95 days after bar trimming.
Environment=LOOKBACK_DAYS=100
Environment=WORKERS=2
Environment=WS_KLINES_ENABLED=1
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
# Registered LONG profile (change point 2026-08-03): v12 = v11a with the stop
# opened to 3x ATR at entry, decayed to 1.5x after 48h by producer-planned
# exits. Standing v11a components keep their published terms and drain under
# the same planner.
Environment=LONG_STRATEGY_PROFILE=v12
# Where this producer writes the book the engine follows, and where it keeps
# its own record of what it asked for. Both are required together: the book is
# absolute, so a producer that forgot what it asked for last cycle would
# re-enter every name it holds, for ever. The book path must match the long
# sleeve's `book_path` in /etc/liquidity-migration/engine.toml.
#
# The state file is this producer's durable request/fill-clock memory. It is
# not in the deployed checkout: deployment proves that tree clean at every
# exact-commit step.
Environment=LONG_ENGINE_TARGET_BOOK_PATH=/var/lib/liquidity-migration/targets/long-demo.json
Environment=LONG_ENGINE_BOOK_STATE_PATH=/var/lib/liquidity-migration/targets/long-demo-state.json
# The LLM gate's judged candidates (written hourly by the llm-ledger service)
# enter through THIS sleeve: same book, same sizing, same exits. Both lines
# are the kill switch -- set ENABLED=0 (or stop the llm-ledger timer) and the
# gate stops contributing entries while everything else runs on.
Environment=LONG_ENGINE_LLM_GATE_CANDIDATES_PATH=/var/lib/liquidity-migration/llm-driver-ledger/llm-gate-candidates.json
Environment=LONG_ENGINE_LLM_GATE_ENABLED=1
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-bybit-long-demo.service main
Restart=always
RestartPreventExitStatus=78
RestartSec=30
KillMode=control-group
TimeoutStopSec=90
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
# Polars reads /proc/meminfo to size its cgroup-aware memory manager.  Keep
# process metadata hidden, but retain the non-process kernel interfaces.
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/opt/liquidity-migration/data /var/lib/liquidity-migration/targets
# No MemoryHigh: measured 2026-08-03 pinned at the old watermark (reclaim
# throttling, swapped pages, slow cycles entering on stale prices). The
# producer restarts clean off the journal cursor, so MemoryMax fails loud
# instead of degrading silently. Sized after the paper retirement freed
# ~740 MiB on the 3.7 GiB host; observed working set ~790M.
MemoryMax=1024M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
