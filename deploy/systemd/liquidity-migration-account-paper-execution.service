[Unit]
Description=liquidity-migration integration-only uncalibrated paper account owner
Wants=network-online.target
After=network-online.target
Before=liquidity-migration-bybit-long-paper.service liquidity-migration-bybit-continuous-paper.service

[Service]
Type=simple
User=liquidity-migration-paper
Group=liquidity-migration-paper
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/account-paper-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET
Environment=ACCOUNT_PAPER_KERNEL_REQUIRED=1
Environment=REAL_MONEY=false
Environment=TELEGRAM_ENABLED=1
# No CONTINUOUS_CYCLE_ROOT: the twin then reports no CONTINUOUS gate line.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-paper-execution.service main
ExecStartPost=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-paper-execution.service readiness
Restart=always
RestartSec=2
TimeoutStartSec=240
KillMode=control-group
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadOnlyPaths=/opt/liquidity-migration
ReadWritePaths=/opt/liquidity-migration/data/bybit-account-paper /opt/liquidity-migration/data/bybit-account-paper-intents /opt/liquidity-migration/data/bybit-account-paper-market-capture
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
