[Unit]
Description=Periodic immutable-prior BTC+ETH target hedge for the continuous demo account route
Wants=network-online.target
# No Requires= on the owner: the hedge publishes into a durable inbox and
# already degrades in-process when owner health is dead, so a restarting owner
# must not stop the hedge pass from being scheduled.
After=network-online.target liquidity-migration-account-execution.service

[Service]
Type=oneshot
# Bound the run below the 5-minute OnUnitActiveSec interval: a oneshot's
# infinity default would let one hung hedge pass suppress every later one.
TimeoutStartSec=300
User=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=ACCOUNT_PAPER_KERNEL_REQUIRED=0
Environment=EXECUTION_ENVIRONMENT=demo
Environment=TELEGRAM_ENABLED=0
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PRIMARY_ROOT=data/bybit-continuous-demo-event
Environment=HEDGE_MODEL_PRIOR=deploy/hedge_warmstart/bybit_warmstart.csv
Environment=HEDGE_ACTION=execute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-continuous-hedge.service main
