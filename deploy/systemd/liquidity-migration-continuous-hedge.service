[Unit]
Description=Periodic BTC+ETH 2f target hedge for the continuous demo book (demo-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HEDGE_VENUE=bybit
Environment=PRIMARY_ROOT=data/bybit-continuous-demo-event
Environment=HEDGE_DATA_ROOT=data/bybit-continuous-hedge-event
# Banked BTC+ETH two-factor form (receipts continuous-hedge-{upgrade,2f-engine}-2026-06-10).
Environment=HEDGE_MODE=2f
# Submit ARMED by operator instruction 2026-06-10 (demo account only; the runner
# refuses without demo credentials and CONFIRM_DEMO_ORDERS=1, and hard-refuses
# REAL_MONEY=true). Set SUBMIT_HEDGE=0 to fall back to dry-run logging.
Environment=SUBMIT_HEDGE=1
Environment=CONFIRM_DEMO_ORDERS=1
# Hardening + memory-cap parity with the sibling units (round 4): this submits
# live demo orders and parses venue JSON as root — it must not be the one
# unconfined unit in the fleet.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
ExecStart=/bin/bash /opt/liquidity-migration/scripts/run_continuous_hedge.sh
