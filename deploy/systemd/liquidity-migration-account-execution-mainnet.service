[Unit]
Description=liquidity-migration single Bybit MAINNET real-money account execution owner
Wants=network-online.target
After=network-online.target
# The default limiter (5 starts / 10s) would latch the owner failed after five
# fast transient failures (a venue blip on the startup permission probe); a
# latched real-money owner leaves exposure unsupervised -- the exact outcome
# Restart=always exists to prevent. RestartSec=2 puts five restarts inside the
# 10 s window, so this owner really would latch. It must live in [Unit]:
# systemd ignores it in [Service] and says so in the journal, which is how it
# sat here doing nothing until 2026-08-09.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
# Disjoint from bybit-demo.env: carries BYBIT_REAL_API_KEY/SECRET and
# REAL_MONEY. Installed by hand, root-owned 0600.
EnvironmentFile=/etc/liquidity-migration/bybit-mainnet.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET
EnvironmentFile=/etc/liquidity-migration/account-execution-mainnet.env
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=ACCOUNT_VENUE_REALM=mainnet
Environment=CONFIRM_DEMO_ORDERS=1
# The owner trades this account by hand and sets leverage on it, so this process
# is not the sole writer of leverage: a flat symbol must forget its cached value
# and re-assert it on the next entry. Costs one set_leverage round trip (~190 ms)
# per fresh entry. Set after hand-set leverage was reported on 2026-08-09; drop
# it back to 0 only when hand-trading stops again.
Environment=ACCOUNT_SHARED_LEVERAGE_AUTHORITY=1
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-execution-mainnet.service main
ExecStartPost=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-execution-mainnet.service readiness
# The owner degrades rather than exits when a startup check fails over open
# exposure, so Restart=always is a recovery path, not a crash loop.
Restart=always
RestartSec=2
TimeoutStartSec=240
KillMode=control-group
TimeoutStopSec=180
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
