[Unit]
Description=liquidity-migration forward-only LLM driver-judgment ledger
Wants=network-online.target
After=network-online.target

[Service]
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Type=oneshot
KillMode=control-group
# ~12 nominations, each a few public reads plus one LLM call; the hourly
# timer must never find a hung run still activating.
TimeoutStartSec=600
User=liquidity-llm
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
# Only the LLM key. This unit reads public market data and holds no venue
# credentials; it can nominate (without judging) even if the file is absent.
EnvironmentFile=-/etc/liquidity-migration/llm-ledger.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liquidity-migration/llm-driver-ledger
StateDirectory=liquidity-migration/llm-driver-ledger
StateDirectoryMode=0750
MemoryMax=512M
# Research must not preempt the signal workers (Nice=5) or owners (Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/research/llm_driver_ledger.py \
    --once --triggers --ledger-dir /var/lib/liquidity-migration/llm-driver-ledger
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
