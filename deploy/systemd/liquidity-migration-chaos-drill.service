[Unit]
Description=liquidity-migration DEMO compatible executable rollback and return

[Service]
Type=oneshot
KillMode=control-group
# Each release switch allows 180s for a healthy process generation.
TimeoutStartSec=900
# Root owns unit overrides and the deployment lock.
User=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/engine.env
EnvironmentFile=/etc/liquidity-migration/notifications.env
EnvironmentFile=/etc/liquidity-migration/oncall.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256M
ExecStart=/opt/liquidity-migration/scripts/runtime/chaos_drill.sh
StandardOutput=journal
StandardError=journal
