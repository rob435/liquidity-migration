[Unit]
Description=Forward Bybit public market recorder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=liquidity-capture
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/research/capture_bybit_forward.py \
    --root /var/lib/liquidity-migration/forward-market \
    --symbols-file deploy/forward-capture-symbols.txt \
    --depth 50 \
    --segment-max-mb 64 \
    --retention-days 30 \
    --max-disk-gb 60 \
    --min-free-disk-gb 25
# 143 is a clean SIGTERM stop.
SuccessExitStatus=143
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=90

StateDirectory=liquidity-migration/forward-market
StateDirectoryMode=0750
ReadWritePaths=/var/lib/liquidity-migration/forward-market
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
LimitNOFILE=65536
TasksMax=128
Nice=12
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
