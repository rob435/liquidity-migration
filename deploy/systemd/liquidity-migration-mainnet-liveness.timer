[Unit]
Description=Run the liquidity-migration mainnet liveness + position-safety watchdog every 3 minutes

[Timer]
# Fast cadence: a down daemon / unprotected position must surface in minutes,
# not the hourly entry-health window. The worker itself calls a healthy
# live-stream backfill `starting` for at most 120 minutes; disconnected or
# incomplete inputs report degraded immediately. Then run every 3 minutes.
OnActiveSec=1min
OnUnitActiveSec=3min
AccuracySec=15s
# Persistent applies only to calendar timers, not this monotonic schedule.

[Install]
WantedBy=timers.target
