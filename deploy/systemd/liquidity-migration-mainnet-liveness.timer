[Unit]
Description=Run the liquidity-migration mainnet liveness + position-safety watchdog every 3 minutes

[Timer]
# Fast cadence: a down daemon / unprotected position must surface in minutes,
# not the hourly entry-health window. The worker calls a healthy cold fill
# `starting` for at most 120 minutes and a later healthy-transport repair
# `recovering` for at most 2; transport faults report degraded immediately.
OnActiveSec=1min
OnUnitActiveSec=3min
AccuracySec=15s
# Persistent applies only to calendar timers, not this monotonic schedule.

[Install]
WantedBy=timers.target
