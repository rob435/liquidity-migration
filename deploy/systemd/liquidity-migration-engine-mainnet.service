[Unit]
Description=liquidity-migration Rust execution engine on the FUNDED account (runs only while REAL_MONEY is armed)
Wants=network-online.target
After=network-online.target

# NO `Conflicts=` with anything, deliberately. What stops two processes trading
# this account is the account's kernel lease, which this engine takes at boot.
# A systemd conflict knows nothing about that lease and would stop the funded
# fleet the moment anyone started this unit.

[Service]
Type=simple
User=liquidity-engine-mainnet
Group=liquidity-migration
# Not the deployed checkout: a relative log path inside /opt/liquidity-migration
# would write an untracked file into the tree the deploy proves clean, and stop
# the next deploy of the fleet. Its own directory, separate from the demo
# engine's, so the two never share a log or a heartbeat.
StateDirectory=liquidity-migration-engine-mainnet
WorkingDirectory=/var/lib/liquidity-migration-engine-mainnet

# The funded account's credentials, and REAL_MONEY.
#
# This file is the owner's. `REAL_MONEY=true` in it is the single switch that
# lets anything reach the funded account, it is set by the owner's own hand,
# and deploy only ever rewrites it atomically to false during explicit disarm.
# Without it the engine refuses to
# build a mainnet gateway at all — it fails at the credential read, before a
# socket is opened, and says which switch is missing.
EnvironmentFile=/etc/liquidity-migration/bybit-mainnet.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
# This owner receives its write-key family plus the exact account user id that
# the gateway binds at startup. Demo and read-only attestor credentials are
# removed even if they were present in PID 1's environment.

# Config path and heartbeat path; deploy/engine.mainnet.env.template is the
# copy to fill in. No live switch lives here: REAL_MONEY in the credential
# file is what decides whether this unit runs at all.
EnvironmentFile=/etc/liquidity-migration/engine-mainnet.env
Environment=LM_CHILD_STOP_GRACE_SECONDS=20

ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-engine-mainnet.service main
# The trusted supervisor records 143 only when the child finishes inside its
# grace period. A forced kill stays a service failure.
SuccessExitStatus=143
Restart=always
RestartPreventExitStatus=78
RestartSec=5
KillMode=control-group
# The engine finishes its current write and drops its account lease on the way
# out; nothing here waits on a venue round trip.
TimeoutStopSec=30

# This process carries real orders; it does not yield CPU to a producer.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=4

NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/run/lock/liquidity-migration /var/lib/liquidity-migration-engine-mainnet
MemoryMax=512M
LimitNOFILE=65536
TasksMax=256

[Install]
WantedBy=multi-user.target
