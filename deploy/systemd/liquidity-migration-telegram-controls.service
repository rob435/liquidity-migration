[Unit]
Description=liquidity-migration Telegram owner controls (pause/resume buttons)
Wants=network-online.target
# No Requires= on the owner or producers: the control panel must keep working
# when the fleet it controls is stopped — that is exactly when it is needed.
After=network-online.target

[Service]
Type=simple
User=liquidity-controls
Group=liquidity-controls
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TELEGRAM_CONTROLS_STATE_DIR=/var/lib/liquidity-migration-telegram-controls
Environment=LM_CHILD_STOP_GRACE_SECONDS=20
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-telegram-controls.service main
# The trusted supervisor records 143 only when the child finishes inside its
# grace period. A forced kill stays a service failure.
SuccessExitStatus=143
Restart=always
RestartPreventExitStatus=78
RestartSec=15
KillMode=control-group
TimeoutStopSec=30
# sudo is usable only for the four exact argv in the root-owned, digest-bound
# liquidity-migration-controls sudoers fragment. The bot itself owns no venue,
# config, unit, checkout, or trust-root write access.
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/liquidity-migration/bybit-demo.env -/etc/liquidity-migration/bybit-mainnet.env -/etc/liquidity-migration/bybit-mainnet-attestor.env -/etc/liquidity-migration/engine.env -/etc/liquidity-migration/engine-mainnet.env -/etc/liquidity-migration/engine.toml -/etc/liquidity-migration/engine-mainnet.toml -/etc/liquidity-migration/producer-demo.env -/etc/liquidity-migration/producer-mainnet.env -/etc/liquidity-migration/telegram-mainnet.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
StateDirectory=liquidity-migration-telegram-controls
StateDirectoryMode=0700
MemoryMax=256M
# An operator surface must not preempt the producers (Nice=5) or owners (-5).
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
