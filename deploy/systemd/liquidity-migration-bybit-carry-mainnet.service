[Unit]
Description=liquidity-migration Bybit carry-hold MAINNET target producer (v7 pre-settle exit clock on the lane2_carry_hold_v7 rule)
Wants=network-online.target
# This producer writes a target book; the Rust engine reads it and owns the
# venue account. There is no process-ordering edge between them.
After=network-online.target

[Service]
Type=simple
User=liquidity-producer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/producer-mainnet.env
EnvironmentFile=/etc/liquidity-migration/engine-mainnet.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=DATA_ROOT=data/bybit-carry-mainnet-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=mainnet
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
# Registered CARRY deployment (rule file + journaled profile name), the same
# dial shape as LONG_STRATEGY_PROFILE on the LONG units. v6's whale halving
# additionally reads Binance's public ratio endpoint (no key, fails open).
Environment=CARRY_STRATEGY_PROFILE=v7
# Sell an exiting name at the settled print that ends it, not at the next
# midnight (owner-directed 2026-08-19; the kill switch is setting this to 0).
Environment=CARRY_EARLY_EXIT=1
# Where this producer writes the book the funded engine follows. Must match the
# carry sleeve's `book_path` in /etc/liquidity-migration/engine-mainnet.toml,
# and nothing checks that agreement for you. Writing a book is not trading, but
# the engine that reads it sends: REAL_MONEY in bybit-mainnet.env is the only
# thing between this book and a real order.
Environment=CARRY_ENGINE_TARGET_BOOK_PATH=/var/lib/liquidity-migration/targets/carry-mainnet.json
# The carry engine replays 90 days of hourly history each cycle (REPLAY_DAYS).
Environment=LOOKBACK_DAYS=90
Environment=WORKERS=2
# WS klines are the primary bar source; REST covers gaps and the hourly
# funding sweep.
Environment=WS_KLINES_ENABLED=1
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-bybit-carry-mainnet.service main
Restart=always
RestartPreventExitStatus=78
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/opt/liquidity-migration/data /var/lib/liquidity-migration/targets
MemoryHigh=1152M
MemoryMax=1408M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
