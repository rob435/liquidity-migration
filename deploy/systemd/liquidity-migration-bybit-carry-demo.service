[Unit]
Description=liquidity-migration Bybit carry-hold demo target producer (lane2_carry_hold_v3)
Wants=network-online.target
# Wants=, not Requires=: a dead owner must not take the producers down with it.
# Producers re-check owner health per cycle and plan entries as blocked while
# still publishing exits, so a degraded fleet keeps draining risk.
Wants=liquidity-migration-account-execution.service
After=network-online.target liquidity-migration-account-execution.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=DATA_ROOT=data/bybit-carry-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=demo
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
# The carry engine replays 90 days of hourly history each cycle (REPLAY_DAYS).
Environment=LOOKBACK_DAYS=90
Environment=WORKERS=2
# Carry has no WS kline plane; market data arrives via bounded public REST.
Environment=WS_KLINES_ENABLED=0
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-bybit-carry-demo.service main
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=90
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027
ReadWritePaths=/opt/liquidity-migration
# No MemoryHigh: measured 2026-08-03 pinned at the old watermark (reclaim
# throttling, swapped pages, slow cycles entering on stale prices). The
# producer restarts clean off the journal cursor, so MemoryMax fails loud
# instead of degrading silently. Sized after the paper retirement freed
# ~740 MiB on the 3.7 GiB host; observed working set ~830M.
MemoryMax=1152M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
