[Unit]
Description=liquidity-migration Bybit carry-hold demo target producer (v7 pre-settle exit clock on the lane2_carry_hold_v7 rule + exodus short)
Wants=network-online.target
# This producer writes a target book; the Rust engine reads it and owns the
# venue account. There is no process-ordering edge between them.
After=network-online.target

[Service]
Type=simple
User=liquidity-producer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/producer-demo.env
EnvironmentFile=/etc/liquidity-migration/engine.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=DATA_ROOT=data/bybit-carry-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=demo
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
# Registered CARRY deployment (rule file + journaled profile name), the same
# dial shape as LONG_STRATEGY_PROFILE on the LONG units. v6's whale halving
# additionally reads Binance's public ratio endpoint (no key, fails open).
Environment=CARRY_STRATEGY_PROFILE=v7
# Sell an exiting name at the settled print that ends it, not at the next
# midnight (owner-directed 2026-08-19; the kill switch is setting this to 0).
Environment=CARRY_EARLY_EXIT=1
# Where this producer writes the book the engine follows. It must be the same
# path as the carry sleeve's `book_path` in /etc/liquidity-migration/engine.toml,
# and nothing checks that agreement for you: two different paths means this
# producer writes a file nobody reads and the engine waits on one nobody
# writes, which from outside looks like a sleeve with no signals.
Environment=CARRY_ENGINE_TARGET_BOOK_PATH=/var/lib/liquidity-migration/targets/carry-demo.json
# The exodus short (lane2_exodus_short_v1): when the pre-settle exit above
# fires, this same process publishes the abandoned position as a SHORT to its
# own engine sleeve, covered 60 min after the settlement. Off = unset the
# profile; the book then drains flat. Same path-agreement warning as above:
# this must match the `exodus` sleeve's book_path in engine.toml.
Environment=EXODUS_SHORT_PROFILE=v1
Environment=EXODUS_ENGINE_TARGET_BOOK_PATH=/var/lib/liquidity-migration/targets/exodus-demo.json
# The carry engine replays 90 days of hourly history each cycle (REPLAY_DAYS).
Environment=LOOKBACK_DAYS=90
Environment=WORKERS=2
# WS klines are the primary bar source (store spans the replay window); REST
# covers gaps and the hourly funding sweep. Bootstrap worker pin matches LONG:
# the one-time ~92-day backfill must not saturate the box at boot.
Environment=WS_KLINES_ENABLED=1
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-bybit-carry-demo.service main
Restart=always
RestartPreventExitStatus=78
RestartSec=30
KillMode=control-group
TimeoutStopSec=90
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
# Polars reads /proc/meminfo to size its cgroup-aware memory manager.  Keep
# process metadata hidden, but retain the non-process kernel interfaces.
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/opt/liquidity-migration/data /var/lib/liquidity-migration/targets
# No MemoryHigh: measured 2026-08-03 pinned at the old watermark (reclaim
# throttling, swapped pages, slow cycles entering on stale prices). The
# producer restarts clean off the journal cursor, so MemoryMax fails loud
# instead of degrading silently. Sized after the paper retirement freed
# ~740 MiB on the 3.7 GiB host; observed working set ~830M, plus headroom
# for the in-memory WS kline store (~92d x 150 symbols) added 2026-08-03.
MemoryMax=1408M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
