[Unit]
Description=liquidity-migration combined-book daily aggregate Telegram report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# Sleeve toggles make the daily message say which books are actually live. The
# resolved file is generated by deploy/lib_sleeves.sh after applying host
# overrides as an off-only narrowing layer.
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=PYTHONDONTWRITEBYTECODE=1
# The daily-SHORT sleeve was ERASED 2026-06-11; its short-data-root argument was
# dropped from this report unit (the report fails open on a missing root and the
# SHORT_SLEEVE toggle defaults to off, so the erased sleeve no longer renders).
ExecStart=/opt/liquidity-migration/.venv/bin/python -m liquidity_migration \
    combined-book-telegram-report \
    --long-data-root data/bybit-long-demo-event \
    --continuous-data-root data/bybit-continuous-demo-event \
    --continuous-paper-data-root data/bybit-continuous-paper-event \
    --continuous-hedge-data-root data/bybit-continuous-hedge-event \
    --include-live-positions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
