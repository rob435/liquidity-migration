[Unit]
Description=Live Bybit liquidation collector (allLiquidation; append-only JSONL, no order path)
After=network-online.target
Wants=network-online.target
# [Unit]-section options since systemd 230 — in [Service] they are ignored.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/liquidity-migration
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/.venv/bin/python -m liquidity_migration.liquidation_collector --root data/liquidations
Restart=always
RestartSec=15
# A crash-loop must be able to reach the terminal 'failed' state the watchdog
# pages on: with RestartSec=15 the default start-limit window (10s) can NEVER
# accumulate 5 starts, so the unit restarted silently forever (audit 2026-06-12
# round 3). 10 starts inside 10 min = systemd gives up -> 'failed' -> page.
# Hardening + memory-cap parity with the daemon units: this parses untrusted
# exchange WS JSON as root on a 4GB box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M

[Install]
WantedBy=multi-user.target
