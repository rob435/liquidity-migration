[Unit]
Description=liquidity-migration MAINNET account-kernel and strategy-input liveness watchdog
Wants=network-online.target
# No Requires= on the owner: the observer must still run when the owner is
# stopped or failed, which is exactly what it alerts on.
After=network-online.target

[Service]
Type=oneshot
# The oneshot default is TimeoutStartSec=infinity, and an OnUnitActiveSec timer
# cannot re-trigger while its unit is activating, so one hung run would silence
# this 3-minute watchdog forever. Bound it under the timer interval.
TimeoutStartSec=120
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution-mainnet.env
# Only for TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID, which share the mainnet
# credential file. The watchdog reads state and pages; it holds no trading
# authority, so the keys and the arming switch are stripped straight back out.
EnvironmentFile=/etc/liquidity-migration/bybit-mainnet.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=ACCOUNT_LIVENESS_SCOPE=mainnet
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-mainnet-liveness.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
