[Unit]
Description=Daily combined-book aggregate Telegram report (08:00 UTC)
# NO Requires=<service> here: it makes every deploy's `systemctl enable --now <timer>`
# also START the service -> duplicate daily Telegram reports on every push (observed live).

[Timer]
# Fires daily at 08:00 UTC. Use OnCalendar=Mon *-*-* 08:00:00 for a
# weekly-only schedule. Persistent=true runs a missed firing on next
# boot, so a box down over 08:00 UTC doesn't silently skip a day.
OnCalendar=*-*-* 08:00:00
AccuracySec=1m
Persistent=true
Unit=liquidity-migration-combined-book-report.service

[Install]
WantedBy=timers.target
