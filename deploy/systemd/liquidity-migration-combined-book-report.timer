[Unit]
Description=Hourly Bybit portfolio Telegram report (:05 UTC)
# NO Requires=<service> here: it makes every deploy's `systemctl enable --now <timer>`
# also START the service -> duplicate Telegram reports on every push (observed live).

[Timer]
# Run just after the hourly strategy boundary so the digest sees the latest
# cycle, while avoiding the entry burst at exactly HH:00. Persistent=true runs
# one missed report after downtime; it does not replay every missed hour.
OnCalendar=*-*-* *:05:00 UTC
AccuracySec=1m
Persistent=true
Unit=liquidity-migration-combined-book-report.service

[Install]
WantedBy=timers.target
