[Unit]
Description=Nightly off-box backup of the state that cannot be rebuilt

[Timer]
# Once a night, off the trading hours that matter least; Persistent so a box
# that was down at 03:17 backs up on the next boot instead of skipping a day.
OnCalendar=*-*-* 03:17:00 UTC
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
