[Unit]
Description=liquidity-migration long-sleeve paper target producer (LongV11aDivWeekendVol)
Wants=network-online.target
Requires=liquidity-migration-account-paper-execution.service
After=network-online.target liquidity-migration-account-paper-execution.service
ConditionPathExists=/etc/liquidity-migration/account-execution-capture-enabled

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/account-paper-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_PAPER_KERNEL_REQUIRED=1
Environment=DATA_ROOT=data/bybit-long-paper-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
# Explicit paper environment publishes targets to the deterministic paper owner.
Environment=EXECUTION_ENVIRONMENT=paper
Environment=TELEGRAM_ENABLED=0
Environment=STRATEGY_PROFILE=LongV11aDivWeekendVol
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=0
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOTIONAL_MULTIPLIER=1
Environment=ENTRY_LEVERAGE=10
Environment=MAX_PROJECTED_INITIAL_MARGIN_PCT_EQUITY=0.5
Environment=MAX_ORDER_NOTIONAL_PCT_EQUITY=0
Environment=MAX_NEW_ENTRIES_PER_CYCLE=5
# div promotion 2026-05-30 (was 10): must match _v11a_long_native_config().universe_size
Environment=UNIVERSE_SIZE=50
# ls-4: >=95 so turnover_median_90d populates after the bar trims (_validate_long_demo_config
# hard-requires it). Was 90 (pre-ls-4) which crash-failed every cycle. Lockstep with demo unit.
Environment=LOOKBACK_DAYS=100
Environment=WORKERS=2
Environment=WS_KLINES_ENABLED=1
# Late fresh-epoch account route and DATA_ROOT override.
EnvironmentFile=-/etc/liquidity-migration/fresh-deploy/liquidity-migration-bybit-long-paper.service.env
ExecStart=/opt/liquidity-migration/scripts/run_authorized_fresh_runtime.sh liquidity-migration-bybit-long-paper.service main
Restart=always
RestartSec=30
KillMode=control-group
# Bootstrap can take 60-120s on a cold start with a large kline universe.
# 90s default would SIGKILL the daemon if shutdown lands mid-bootstrap.
# Manager now respects shutdown_event, but keep margin for very slow REST.
TimeoutStopSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=2G

[Install]
WantedBy=multi-user.target
