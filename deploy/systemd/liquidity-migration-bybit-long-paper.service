[Unit]
Description=liquidity-migration integration-only uncalibrated LONG paper target producer
Wants=network-online.target
Requires=liquidity-migration-account-paper-execution.service
After=network-online.target liquidity-migration-account-paper-execution.service
ConditionPathExists=/etc/liquidity-migration/account-execution-operational-ready

[Service]
Type=simple
User=liquidity-migration-paper
Group=liquidity-migration-paper
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/account-paper-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_PAPER_KERNEL_REQUIRED=1
Environment=REAL_MONEY=false
Environment=DATA_ROOT=data/bybit-long-paper-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=paper
Environment=TELEGRAM_ENABLED=0
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Match the demo producer's 100-day feature window.
Environment=LOOKBACK_DAYS=100
Environment=WORKERS=2
Environment=WS_KLINES_ENABLED=1
Environment=KLINES_FOLLOW_ROOT=data/bybit-long-demo-event
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-bybit-long-paper.service main
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadOnlyPaths=/opt/liquidity-migration
ReadWritePaths=/opt/liquidity-migration/data/bybit-account-paper /opt/liquidity-migration/data/bybit-account-paper-intents /opt/liquidity-migration/data/bybit-account-paper-market-capture /opt/liquidity-migration/data/bybit-long-paper-event
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
