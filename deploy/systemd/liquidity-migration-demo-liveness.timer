[Unit]
Description=Run the liquidity-migration liveness + position-safety watchdog every 3 minutes

[Timer]
# Fast cadence: a down daemon / unprotected position must surface in minutes,
# not the hourly entry-health window. The first pass is one minute after the
# timer arms. The worker itself calls a healthy live-stream backfill `starting`
# for at most 120 minutes; disconnected or incomplete inputs report degraded
# immediately. Then run every 3 minutes regardless of prior run duration.
OnActiveSec=1min
OnUnitActiveSec=3min
AccuracySec=15s
# Persistent applies only to calendar timers, not this monotonic schedule.

[Install]
WantedBy=timers.target
