[Unit]
Description=liquidity-migration attributed fills and closed trades to the owner's DM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
KillMode=control-group
# Three file reads and a handful of Telegram sends; the 5-minute timer must
# never find a hung run still activating.
TimeoutStartSec=120
User=liquidity-observer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
# Notification transport is independent of every venue credential.
EnvironmentFile=/etc/liquidity-migration/notifications.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/liquidity-migration/notifications.env -/etc/liquidity-migration/oncall.env -/etc/liquidity-migration/bybit-demo.env -/etc/liquidity-migration/bybit-mainnet.env
StateDirectory=liquidity-migration/trade-notify
ReadWritePaths=/var/lib/liquidity-migration/trade-notify
MemoryMax=256M
# An observer must not preempt the signal workers (Nice=5) or owners (Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/runtime/notify_book_changes.py
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
