[Unit]
Description=liquidity-migration trade updates: book entries and exits to the owner's DM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
KillMode=control-group
# Three file reads and a handful of Telegram sends; the 5-minute timer must
# never find a hung run still activating.
TimeoutStartSec=120
User=liquidity-observer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
# The Telegram token rides in the venue env file; the venue credentials are
# stripped right back out -- this unit talks to the phone, never the account.
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
StateDirectory=liquidity-migration/book-notify
ReadWritePaths=/var/lib/liquidity-migration/book-notify
MemoryMax=256M
# An observer must not preempt the producers (Nice=5) or the owners (Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-trade-notify.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
