[Unit]
Description=liquidity-migration Bybit continuous-fade paper (dry-run) sleeve
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
Environment=DATA_ROOT=data/bybit-continuous-paper-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
# PAPER shadow of the continuous-demo sleeve: NO order submission, idealized fills
# at the signal price. SUBMIT_ORDERS=0 + RECORD_DRY_RUN=1 + PAPER_MODE=1 routes
# writes to continuous_fade_paper_* so reconcile-continuous-paper-demo can pair
# this against the live demo ledger and measure execution slippage. Without
# PAPER_MODE=1 it would silently write the demo dataset names → reconcile paired=0.
Environment=SUBMIT_ORDERS=0
Environment=CONFIRM_DEMO_ORDERS=0
Environment=RECORD_DRY_RUN=1
Environment=PAPER_MODE=1
Environment=TELEGRAM_ENABLED=0
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LOOKBACK_DAYS=45
Environment=WORKERS=2
# Every knob below MUST match the demo unit so the paper run is a true shadow.
Environment=MAX_ACTIVE=25
Environment=MAX_NEW_ENTRIES_PER_CYCLE=5
Environment=MAX_HOLD_HOURS=24
# 2026-06-18: mirrors the repaired demo live-v2 demo/paper lifecycle:
# inverse-vol component sizing, max4 daily vol-target rebalance, TP/24h only.
Environment=STRATEGY_PROFILE=continuous_ensemble_v2
Environment=FEATURE_SET=max_ret168
Environment=ENTRY_EVENT_TRIGGER=none
Environment=BTC_TREND_GATE=uptrend
Environment=DAILY_REBALANCE_ENABLED=1
Environment=DAILY_REBALANCE_TARGET_DAILY_VOL=0.045
Environment=DAILY_REBALANCE_MAX_SCALE=4
Environment=DAILY_REBALANCE_DRAWDOWN_HALF_THRESHOLD=-0.04
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_WINDOW_DAYS=0
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_MIN_RETURN=0
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_SCALE_WHEN_BELOW=0
Environment=STOP_LOSS_PCT=0
Environment=LEFT_DECILE_EXIT_ENABLED=0
Environment=STOP_APPROACH_FRAC=0
Environment=FAILED_FADE_HOURS=0
Environment=FAILED_FADE_LOSS_PCT=0
Environment=FAILED_FADE_MIN_MFE_PCT=0
Environment=BREAKEVEN_ARM_PCT=0
Environment=ENTRY_LEVERAGE=2
Environment=PER_POSITION_NOTIONAL_PCT_EQUITY=2
Environment=SIZING_MODE=inverse_vol
Environment=TARGET_VOL_PER_NAME=0.01
Environment=VOL_WEIGHT_CLAMP=2
Environment=LIQ_TURNOVER_MIN=500000
# Market-data plane: this PAPER shadow runs its OWN kline pool.
# 2026-06-14 (deploy-env-timers-3): we previously set
#   Environment=KLINES_FOLLOW_ROOT=data/bybit-continuous-demo-event
# so the shadow followed the demo root's flushed kline snapshot (+rmom gate)
# read-only to halve the box's WS decode CPU. That was only safe while the demo
# (leader) sleeve was ON. The documented-valid CONTINUOUS_SLEEVE=off +
# CONTINUOUS_PAPER_SLEEVE=on combo (continuous_rmom_refresh_on() is true if
# EITHER sleeve is on; tests/test_sleeve_kill_switch.py pins this) stops the demo
# daemon, freezes its kline store, and left this shadow following a stale snapshot
# for up to ~2 days while appearing healthy — defeating the paper sleeve's whole
# purpose (forward execution/cost calibration). Dropping the follow override means
# the shadow always streams its own pool, so it stays live regardless of the demo
# sleeve's state. Re-add the line ONLY behind a systemd drop-in conditional on the
# demo sleeve being on if the WS-CPU saving is needed again.
# Two daemons x full-width default threadpools on a 2-core box just buys context
# switching; pin to 1 — the daemon's own WORKERS parallelism is the intended knob.
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration/scripts/run_bybit_continuous_demo_event_engine.sh
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=4G

[Install]
WantedBy=multi-user.target
