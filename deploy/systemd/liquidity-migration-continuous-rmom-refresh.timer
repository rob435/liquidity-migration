[Unit]
Description=Daily refresh of the continuous-fade rmom gate (residual_momentum.parquet)

[Timer]
# Shortly after the 00:00 UTC daily-close roll, so residual_momentum[today] is built from the
# just-completed day before the continuous cycles need it. Persistent: catch up after downtime.
OnCalendar=*-*-* 00:20:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
