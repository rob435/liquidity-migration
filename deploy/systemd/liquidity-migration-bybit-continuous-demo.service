[Unit]
Description=liquidity-migration Bybit continuous-fade demo sleeve (sub-hourly, ticker-driven)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
Environment=DATA_ROOT=data/bybit-continuous-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
# Dormant order-submitting unit. The committed deploy toggle keeps CONTINUOUS_SLEEVE=off,
# so deploy disables this unit by default; the continuous paper collector is the only
# continuous service expected to run unless the operator explicitly re-enables demo orders.
# Preconditions are still wired before any future enable: the risk service reads
# CONTINUOUS_DATA_ROOT, the continuous_fade_* datasets are registered, and ws_risk routes
# continuous fills/orphans into the continuous ledger. Demo account ONLY; never REAL_MONEY.
Environment=SUBMIT_ORDERS=1
Environment=CONFIRM_DEMO_ORDERS=1
Environment=TELEGRAM_ENABLED=1
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LOOKBACK_DAYS=45
Environment=WORKERS=2
Environment=MAX_ACTIVE=25
Environment=MAX_NEW_ENTRIES_PER_CYCLE=5
Environment=MAX_HOLD_HOURS=24
Environment=STRATEGY_PROFILE=continuous_rebalance_v1
Environment=FEATURE_SET=max_ret168
Environment=ENTRY_EVENT_TRIGGER=turn4_pop4
Environment=BTC_TREND_GATE=uptrend
Environment=DAILY_REBALANCE_ENABLED=1
# Wide server-side disaster stop (Bybit-managed; fires even if the daemon is down). The state exit
# ("left the decile") is a PROFIT exit a squeezing short never triggers, so this is the only hard
# catastrophe cap. 0.25 = operator I-phase cap. Set 0 ONLY for an explicit unstopped diagnostic.
Environment=STOP_LOSS_PCT=0.25
Environment=ENTRY_LEVERAGE=2
Environment=PER_POSITION_NOTIONAL_PCT_EQUITY=2
Environment=LIQ_TURNOVER_MIN=500000
Environment=WS_KLINES_ENABLED=1
ExecStart=/opt/liquidity-migration/scripts/run_bybit_continuous_demo_event_engine.sh
Restart=always
RestartSec=30
KillMode=control-group
# Cold-start bootstrap of the broad kline universe can take 60-120s.
TimeoutStopSec=180
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
# Broad (top-250) kline store + per-cycle cross-section recompute. Cap at 4G;
# normal operation sits well under 1G. Lower the kline universe size if memory-bound.
MemoryMax=4G

[Install]
WantedBy=multi-user.target
