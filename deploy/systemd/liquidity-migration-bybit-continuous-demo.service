[Unit]
Description=liquidity-migration Bybit continuous-fade demo sleeve (sub-hourly, ticker-driven)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=DATA_ROOT=data/bybit-continuous-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
# Order-submitting demo unit. The risk service reads CONTINUOUS_DATA_ROOT, the
# continuous_fade_* datasets are registered, and ws_risk routes continuous
# fills/orphans into the continuous ledger.
Environment=SUBMIT_ORDERS=1
Environment=CONFIRM_DEMO_ORDERS=1
Environment=TELEGRAM_ENABLED=1
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LOOKBACK_DAYS=45
Environment=WORKERS=2
Environment=MAX_ACTIVE=25
Environment=MAX_NEW_ENTRIES_PER_CYCLE=5
Environment=MAX_HOLD_HOURS=24
# continuous_ensemble_v2 resolves TP12, daily vol-target rebalance disabled,
# CTRL_BTC_RISK_70_90_35 BTC-risk sizing, TP/24h daemon exits, and no server stop.
Environment=STRATEGY_PROFILE=continuous_ensemble_v2
Environment=FEATURE_SET=max_ret168
Environment=ENTRY_EVENT_TRIGGER=none
# Risk rollback 2026-07-10: the demo-only +8% adverse add amplified the
# 1000TAGUSDT squeeze loss and has no paper/backtest parity. Keep it explicitly
# OFF until a new preregistered two-venue replay plus forward paper evidence
# earns reactivation.
Environment=CONTINUOUS_SNIPER=0
Environment=BTC_TREND_GATE=uptrend
Environment=DAILY_REBALANCE_ENABLED=0
Environment=DAILY_REBALANCE_REALIZED_VOL_WINDOW_DAYS=90
Environment=DAILY_REBALANCE_TARGET_DAILY_VOL=0.045
Environment=DAILY_REBALANCE_MAX_SCALE=4
Environment=DAILY_REBALANCE_DRAWDOWN_HALF_THRESHOLD=-0.04
Environment=DAILY_REBALANCE_RESIZE_COST_BPS=10
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_WINDOW_DAYS=0
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_MIN_RETURN=0
Environment=DAILY_REBALANCE_STRATEGY_MOMENTUM_SCALE_WHEN_BELOW=0
Environment=STOP_LOSS_PCT=0
Environment=LEFT_DECILE_EXIT_ENABLED=0
Environment=STOP_APPROACH_FRAC=0
Environment=FAILED_FADE_HOURS=0
Environment=FAILED_FADE_LOSS_PCT=0
Environment=FAILED_FADE_MIN_MFE_PCT=0
Environment=BREAKEVEN_ARM_PCT=0
# Demo-only forward execution stress: 10x exchange leverage supplies margin and
# NOTIONAL_MULTIPLIER=10 actually scales order quantity.  The registered 1x
# research object remains unchanged; results from this epoch are execution and
# lifecycle evidence at 10x scale, not 1x alpha validation.
Environment=ENTRY_LEVERAGE=10
Environment=NOTIONAL_MULTIPLIER=10
Environment=PER_POSITION_NOTIONAL_PCT_EQUITY=2
Environment=SIZING_MODE=inverse_vol
Environment=TARGET_VOL_PER_NAME=0.01
Environment=VOL_WEIGHT_CLAMP=2
Environment=LIQ_TURNOVER_MIN=500000
Environment=ENTRY_PORTFOLIO_HEAT_CAP_FRAC=0
Environment=ENTRY_PORTFOLIO_HEAT_SHOCK_FRAC=1
Environment=ENTRY_ACCOUNT_DRAWDOWN_KILL_SWITCH_FRAC=0
# Two daemons x full-width default threadpools on a 2-core box just buys context
# switching; pin to 1 — the daemon's own WORKERS parallelism is the intended knob.
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration/scripts/run_bybit_continuous_demo_event_engine.sh
Restart=always
RestartSec=30
KillMode=control-group
# Cold-start bootstrap of the broad kline universe can take 60-120s.
TimeoutStopSec=180
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
# Broad (top-250) kline store + per-cycle cross-section recompute. Cap at 4G;
# normal operation sits well under 1G. Lower the kline universe size if memory-bound.
MemoryMax=4G

[Install]
WantedBy=multi-user.target
