[Unit]
Description=liquidity-migration Bybit continuous-fade demo target producer
Wants=network-online.target
Requires=liquidity-migration-account-execution.service
After=network-online.target liquidity-migration-account-execution.service
ConditionPathExists=/etc/liquidity-migration/account-execution-operational-ready

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=DATA_ROOT=data/bybit-continuous-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=demo
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LOOKBACK_DAYS=45
Environment=WORKERS=2
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-bybit-continuous-demo.service main
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027
ReadWritePaths=/opt/liquidity-migration
MemoryHigh=768M
MemoryMax=896M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
