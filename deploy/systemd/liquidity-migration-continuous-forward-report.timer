[Unit]
Description=Daily continuous-vs-daily forward comparator report (08:10 UTC)
Requires=liquidity-migration-continuous-forward-report.service

[Timer]
# Fires after the combined-book report. The script suppresses Telegram while the
# overlapping forward window is below min_common_days, but still writes a report.
OnCalendar=*-*-* 08:10:00
AccuracySec=1m
Persistent=true
Unit=liquidity-migration-continuous-forward-report.service

[Install]
WantedBy=timers.target
