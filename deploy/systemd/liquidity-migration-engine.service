[Unit]
Description=liquidity-migration Rust execution engine on the fleet's demo account (shadow unless turned on)
Wants=network-online.target
# No edge to the producers, in either direction. They write books on their own
# clock and read this engine's heartbeat for the equity they size from; both
# halves fail closed when the other is missing, and neither needs the other to
# start. An edge would also let a stuck producer delay the process that carries
# the orders, which is the wrong way round.
After=network-online.target

[Service]
Type=simple
User=root
Group=root
# Not the deployed checkout. The engine's log path in engine.toml may be
# relative, and a relative path resolved inside /opt/liquidity-migration writes
# an untracked file into the tree the deploy proves clean at every exact-commit
# step — which would stop the next deploy of the funded fleet. systemd creates
# this directory before the engine starts.
StateDirectory=liquidity-migration-engine
WorkingDirectory=/var/lib/liquidity-migration-engine
# The FLEET's demo account, 555899665. This used to name bybit-quote-lab.env,
# the engine's own second demo account (579580669), and the reason was real:
# liquidity-migration-account-execution.service owned this account, two writers
# on one venue account wedge each other, and on 2026-08-14 01:56 a live engine
# here blocked that owner for about a hundred seconds.
#
# That owner was deleted with the rest of the Python order path. Nothing else
# writes to this account now, and the engine is what the producers publish
# their books to — so it has to be this account, not a second one. The kernel
# lease still holds: if anything else does take the account, the engine refuses
# to start rather than fighting it.
#
# The Telegram tokens in this file are unset below. The engine sends no
# messages, and a process that cannot reach the owner's chat cannot post to it
# by accident.
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
# Config path, heartbeat path, and the shadow/live switch. deploy/engine.env.template
# is the copy to fill in. The engine is shadow unless this file says otherwise.
EnvironmentFile=/etc/liquidity-migration/engine.env
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-engine.service main
Restart=always
RestartSec=5
KillMode=control-group
# The engine finishes its current write and drops its account lock on the way
# out; nothing here waits on a venue round trip.
TimeoutStopSec=30
# Ahead of the producers (5), because this is now the process that carries the
# orders on the demo account: a producer's minute-long cycle must not delay an
# exit. Still behind the funded engine (-5) on a two-core box.
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027
ReadWritePaths=/var/lib/liquidity-migration-engine
MemoryMax=256M

[Install]
WantedBy=multi-user.target
