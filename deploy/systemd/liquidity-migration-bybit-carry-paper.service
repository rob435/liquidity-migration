[Unit]
Description=liquidity-migration integration-only uncalibrated CARRY paper target producer
Wants=network-online.target
Requires=liquidity-migration-account-paper-execution.service
After=network-online.target liquidity-migration-account-paper-execution.service

[Service]
Type=simple
User=liquidity-migration-paper
Group=liquidity-migration-paper
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/account-paper-execution.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID
Environment=ACCOUNT_PAPER_KERNEL_REQUIRED=1
Environment=REAL_MONEY=false
Environment=DATA_ROOT=data/bybit-carry-paper-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
# Publishes component targets to the paper owner; it never touches the venue.
Environment=EXECUTION_ENVIRONMENT=paper
Environment=INTERVAL_SECONDS=60
Environment=PYTHONDONTWRITEBYTECODE=1
# Match the demo producer's 90-day replay window.
Environment=LOOKBACK_DAYS=90
Environment=WORKERS=2
# Carry has no WS kline plane; market data arrives via bounded public REST.
Environment=WS_KLINES_ENABLED=0
# Follow the demo producer's bounded public market store read-only. Paper
# retains its own strategy/journal roots and falls back to public REST for
# missing bars.
Environment=CARRY_MARKET_FOLLOW_ROOT=data/bybit-carry-demo-event
Environment=POLARS_MAX_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-bybit-carry-paper.service main
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadOnlyPaths=/opt/liquidity-migration
ReadWritePaths=/opt/liquidity-migration/data/bybit-account-paper /opt/liquidity-migration/data/bybit-account-paper-intents /opt/liquidity-migration/data/bybit-account-paper-market-capture /opt/liquidity-migration/data/bybit-carry-paper-event
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
