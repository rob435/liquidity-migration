[Unit]
Description=Bybit forward order-book depth collector (hourly band snapshots; public REST, append-only JSONL, no order path). NOT auto-enabled by deploy: operator enables explicitly (systemctl enable --now liquidity-migration-depth-collector).
After=network-online.target
Wants=network-online.target
# [Unit]-section options since systemd 230 — in [Service] they are ignored.
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/liquidity-migration
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/.venv/bin/python -m liquidity_migration.depth_collector --root data/depth
Restart=always
RestartSec=30
# See the liquidation collector: let a crash-loop terminally fail (watchdog
# pages on 'failed'); hardening + memory-cap parity with the daemon units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M

[Install]
WantedBy=multi-user.target
