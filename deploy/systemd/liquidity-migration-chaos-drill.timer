[Unit]
Description=Weekly compatible executable rollback rehearsal on DEMO

[Timer]
# Sunday morning UTC, when the owner is most likely awake for a latched
# verdict. Deliberately NOT Persistent: a box booting after an outage has
# needs its normal deployment verified before another release switch.
OnCalendar=Sun *-*-* 09:13:00 UTC
AccuracySec=10min

[Install]
WantedBy=timers.target
