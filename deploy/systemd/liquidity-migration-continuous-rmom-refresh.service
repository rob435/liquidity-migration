[Unit]
Description=Refresh the continuous-fade rmom gate (residual_momentum.parquet) on enabled continuous roots
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
Environment=POLARS_MAX_THREADS=8
Environment=PYTHONDONTWRITEBYTECODE=1
# The continuous signal gates on residual_momentum.parquet; rebuild it daily from each
# enabled continuous root's own kline store so the causal shift-3 trailing residual
# sum is fresh for rmom[today]. The wrapper reads deploy/sleeves.env plus /etc
# overrides, so paper-only evidence collection works while the order-submitting
# demo sleeve remains off.
ExecStart=/bin/bash /opt/liquidity-migration/scripts/run_continuous_rmom_refresh.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration

[Install]
WantedBy=multi-user.target
