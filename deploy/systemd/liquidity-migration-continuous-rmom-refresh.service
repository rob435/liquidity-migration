[Unit]
Description=Refresh the shared continuous-fade RMOM gate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The oneshot default is TimeoutStartSec=infinity, and `seed_rmom`'s retry
# deadline cannot fire while a synchronous `systemctl start` is still activating.
TimeoutStartSec=900
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=POLARS_MAX_THREADS=8
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-continuous-rmom-refresh.service main
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027
ReadWritePaths=/opt/liquidity-migration
# The full-rewrite refresh (POLARS_MAX_THREADS=8) is the heaviest managed
# workload; without a ceiling it pressures the global OOM killer against the
# co-resident demo account owner on the 3.7 GiB host. MemoryHigh throttles
# first; MemoryMax is a guard bound, not a target. Re-enabling CONTINUOUS
# needs a fleet re-budget: this 1G high plus the producer ceilings raised
# after the 2026-08-03 paper retirement do not all fit without accepting
# swap during refresh windows.
MemoryHigh=1G
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
