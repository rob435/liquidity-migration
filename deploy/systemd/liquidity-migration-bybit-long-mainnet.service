[Unit]
Description=liquidity-migration LONG MAINNET target producer (LongV12WideStop)
Wants=network-online.target
# This producer writes a target book; the Rust engine reads it and owns the
# venue account. There is no process-ordering edge between them.
After=network-online.target

[Service]
Type=simple
User=liquidity-producer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/producer-mainnet.env
EnvironmentFile=/etc/liquidity-migration/engine-mainnet.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=DATA_ROOT=data/bybit-long-mainnet-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=EXECUTION_ENVIRONMENT=mainnet
Environment=TELEGRAM_ENABLED=0
Environment=INTERVAL_SECONDS=60
Environment=USE_DAEMON=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The 90-day turnover rank requires at least 95 days after bar trimming.
Environment=LOOKBACK_DAYS=100
Environment=WORKERS=2
Environment=WS_KLINES_ENABLED=1
Environment=WS_KLINES_BOOTSTRAP_WORKERS=2
# Same registered profile as demo (change point 2026-08-03). Wiring only:
# the single arming switch is REAL_MONEY=true in
# /etc/liquidity-migration/bybit-mainnet.env, set by the operator.
Environment=LONG_STRATEGY_PROFILE=v12
# The book the funded engine follows, and this producer's own record of what it
# asked for. Required together: the book is absolute, so a producer that forgot
# what it asked for last cycle would re-enter every name it holds, for ever.
Environment=LONG_ENGINE_TARGET_BOOK_PATH=/var/lib/liquidity-migration/targets/long-mainnet.json
Environment=LONG_ENGINE_BOOK_STATE_PATH=/var/lib/liquidity-migration/targets/long-mainnet-state.json
# Append-only enter/leave attribution log; see the demo unit's note.
Environment=LONG_ENGINE_BOOK_TRANSITIONS_PATH=/var/lib/liquidity-migration/targets/long-mainnet-transitions.jsonl
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-bybit-long-mainnet.service main
Restart=always
RestartPreventExitStatus=78
RestartSec=30
KillMode=control-group
TimeoutStopSec=180
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
# Polars reads /proc/meminfo to size its cgroup-aware memory manager.  Keep
# process metadata hidden, but retain the non-process kernel interfaces.
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/opt/liquidity-migration/data /var/lib/liquidity-migration/targets
MemoryHigh=576M
MemoryMax=640M
MemorySwapMax=384M

[Install]
WantedBy=multi-user.target
