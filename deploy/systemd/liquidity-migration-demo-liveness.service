[Unit]
Description=liquidity-migration account-kernel and strategy-input liveness watchdog
Wants=network-online.target
# The observer must run when the account owner is stopped or failed. Coupling
# activation would restart the writer or suppress the very alert this unit owns.
After=network-online.target

[Service]
Type=oneshot
# systemd's oneshot default is TimeoutStartSec=infinity, and an OnUnitActiveSec
# timer cannot re-trigger while its unit is still activating: a single hung run
# would silently stop this 3-minute position-safety watchdog forever. Bound the
# run to well under the timer interval so a wedged run goes `failed` (which the
# verify/reset paths already handle) instead of silencing the alarm.
TimeoutStartSec=120
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-demo-liveness.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
