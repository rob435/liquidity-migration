[Unit]
Description=liquidity-migration account-kernel and strategy-input liveness watchdog
Wants=network-online.target
# No Requires= on the owner: the observer must still run when the owner is
# stopped or failed, which is exactly what it alerts on.
After=network-online.target

[Service]
Type=oneshot
# The oneshot default is TimeoutStartSec=infinity, and an OnUnitActiveSec timer
# cannot re-trigger while its unit is activating, so one hung run would silence
# this 3-minute watchdog forever. Bound it under the timer interval.
TimeoutStartSec=120
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# The engine's file, for LIVENESS_ENGINE_HEARTBEAT_FILE — the other half of the
# heartbeat the engine writes. Leading `-`: most hosts do not run the engine and
# do not have this file, and a watchdog that will not start is the one failure
# nothing else would report. No file means the variable is unset, which means
# the engine check is skipped entirely rather than paging about a heartbeat
# nobody writes.
EnvironmentFile=-/etc/liquidity-migration/engine.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
# An observer must not preempt the producers it observes (they run Nice=5,
# the owners Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-demo-liveness.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
