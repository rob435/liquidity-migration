[Unit]
Description=liquidity-migration account-kernel and strategy-input liveness watchdog
Wants=network-online.target
Requires=liquidity-migration-account-execution.service
After=network-online.target liquidity-migration-account-execution.service
ConditionPathExists=/etc/liquidity-migration/account-execution-operational-ready

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/account-execution.env
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-demo-liveness.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
