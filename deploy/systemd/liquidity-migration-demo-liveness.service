[Unit]
Description=liquidity-migration fast liveness + position-safety watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# Per-sleeve kill-switch toggles (deploy/sleeves.env defaults, then the optional host override)
# so the watchdog skips an intentionally-off sleeve instead of paging it as a dead daemon.
# `-` = optional (don't fail the unit if absent). Host file (loaded last) wins.
EnvironmentFile=-/opt/liquidity-migration/deploy/sleeves.env
EnvironmentFile=-/etc/liquidity-migration/sleeves.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Alerts on daemon-down/hung, an UNPROTECTED open position (no/wrong venue
# stopLoss), ledger<->venue mismatch, WS feed stall, and exchange errors so the
# operator can manually close. Exits 0 always (a watchdog must never crash-loop).
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/check_demo_liveness.py \
    --data-root /opt/liquidity-migration/data/bybit-demo-event \
    --continuous-root /opt/liquidity-migration/data/bybit-continuous-demo-event \
    --continuous-paper-root /opt/liquidity-migration/data/bybit-continuous-paper-event \
    --long-root /opt/liquidity-migration/data/bybit-long-demo-event \
    --max-cycle-age-min 10 \
    --cooldown-min 30 \
    --telegram
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
