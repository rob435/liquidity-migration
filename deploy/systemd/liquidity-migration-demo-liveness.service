[Unit]
Description=liquidity-migration fast liveness + position-safety watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# Per-sleeve kill-switch toggles resolved by deploy/lib_sleeves.sh. Host overrides
# can only turn a repo-on sleeve off; stale host "on" values cannot resurrect a
# repo-disabled sleeve.
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Hardening + memory-cap parity with the sibling units (round 4): handles
# credentials and pings external URLs as root.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryMax=512M
# Alerts on daemon-down/hung, an UNPROTECTED stop-required open position
# (no/wrong venue stopLoss), ledger<->venue mismatch, WS feed stall, and
# exchange errors so the operator can manually close. Continuous v2 is
# intentionally no-stop demo/paper, so this unit does not pass
# --continuous-stop-check. Exits 0 always (a watchdog must never crash-loop).
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/check_demo_liveness.py \
    --continuous-root /opt/liquidity-migration/data/bybit-continuous-demo-event \
    --continuous-paper-root /opt/liquidity-migration/data/bybit-continuous-paper-event \
    --long-root /opt/liquidity-migration/data/bybit-long-demo-event \
    --max-cycle-age-min 10 \
    --cooldown-min 30 \
    --telegram
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
