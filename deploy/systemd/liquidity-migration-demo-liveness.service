[Unit]
Description=liquidity-migration Rust owner and strategy-input liveness watchdog
Wants=network-online.target
# No Requires= on the owner: the observer must still run when the owner is
# stopped or failed, which is exactly what it alerts on.
After=network-online.target

[Service]
Type=oneshot
KillMode=control-group
# The oneshot default is TimeoutStartSec=infinity, and an OnUnitActiveSec timer
# cannot re-trigger while its unit is activating, so one hung run would silence
# this 3-minute watchdog forever. Bound it under the timer interval.
TimeoutStartSec=120
User=liquidity-observer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
EnvironmentFile=/etc/liquidity-migration/producer-demo.env
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# Required binding and heartbeat path for the mandatory Rust account owner.
# A missing file stops the observer instead of silently skipping engine health.
EnvironmentFile=/etc/liquidity-migration/engine.env
# The dead-man's switch URL, and nothing else. An on-box watchdog cannot
# report that the box died, so without this a total host loss is silent.
# Optional: absent means the switch is not provisioned and silence stays
# ambiguous. One line, LIVENESS_HEARTBEAT_URL=...
EnvironmentFile=-/etc/liquidity-migration/liveness.env
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY
Environment=TELEGRAM_ENABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
# Polars reads /proc/meminfo to size its cgroup-aware memory manager.  Keep
# process metadata hidden, but retain the non-process kernel interfaces.
ProtectSystem=strict
ProtectHome=true
StateDirectory=liquidity-migration/liveness-demo
Environment=LIVENESS_STATE_FILE=/var/lib/liquidity-migration/liveness-demo/state.json
ReadWritePaths=/var/lib/liquidity-migration/liveness-demo
MemoryMax=512M
# An observer must not preempt the producers it observes (they run Nice=5,
# the owners Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration-engine/bin/run-authorized-runtime liquidity-migration-demo-liveness.service main
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
