[Unit]
Description=Diff the target books for trade updates every 5 minutes

[Timer]
# Books change on the producers' own clocks (midnight for carry, any cycle
# for LONG, settlements for exodus); five minutes keeps the phone close to
# the decision without re-reading three small files to no purpose.
OnCalendar=*-*-* *:0/5:30
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
