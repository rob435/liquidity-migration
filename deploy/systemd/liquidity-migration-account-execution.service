[Unit]
Description=liquidity-migration single Bybit demo account execution owner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/liquidity-migration/account-execution-operational-ready

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
UnsetEnvironment=BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET
EnvironmentFile=/etc/liquidity-migration/account-execution.env
Environment=ACCOUNT_EXECUTION_KERNEL_REQUIRED=1
Environment=CONFIRM_DEMO_ORDERS=1
Environment=TELEGRAM_ENABLED=1
Environment=CONTINUOUS_CYCLE_ROOT=/opt/liquidity-migration/data/bybit-continuous-demo-event
Environment=CONTINUOUS_CYCLE_MAX_AGE_MINUTES=15
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-execution.service main
ExecStartPost=/opt/liquidity-migration/scripts/run_authorized_runtime.sh liquidity-migration-account-execution.service readiness
Restart=always
RestartSec=2
TimeoutStartSec=240
KillMode=control-group
TimeoutStopSec=180
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
