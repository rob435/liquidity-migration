[Unit]
Description=Pack each finished hour of the market tape into one archive and upload it to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
UnsetEnvironment=BYBIT_DEMO_API_KEY BYBIT_DEMO_API_SECRET BYBIT_REAL_API_KEY BYBIT_REAL_API_SECRET BYBIT_REAL_API_KEY_IP BYBIT_REAL_API_KEY_BACKUP_IP BYBIT_ATTEST_API_KEY BYBIT_ATTEST_API_SECRET BYBIT_ATTEST_API_KEY_IP BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID REAL_MONEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TELEGRAM_ALERT_CHAT_ID
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RCLONE_CONFIG=/var/lib/liquidity-migration/market-tape-upload/rclone.conf
Environment=RCLONE_CONFIG_SEED=/etc/liquidity-migration/rclone.conf
# One run ships every tape; a tape whose recorder has not started yet is skipped.
# --keep-hours is the local sliding window: a shipped hour's segments are
# deleted from the recorder's root once it has been over this long. An hour
# not in the ledger is never deleted here.
ExecStart=/opt/liquidity-migration/.venv/bin/python -m market_tape pack \
    --tape bybit-linear=/var/lib/liquidity-migration/forward-market \
    --tape binance-usdm=/var/lib/liquidity-migration/forward-market-binance \
    --remote-base gdrive:LiquidityMigration/market-tape \
    --state-dir /var/lib/liquidity-migration/market-tape-upload \
    --stamp-file /var/lib/liquidity-migration/receipts/market-tape-upload.last-success \
    --keep-hours 24
KillMode=control-group
# A legacy day repack can be several gigabytes; still bounded under the hourly
# cadence so a hung run cannot stack.
TimeoutStartSec=3000

StateDirectory=liquidity-migration/market-tape-upload
StateDirectoryMode=0700
# The tape roots are writable so the run can delete the hours it has shipped.
ReadWritePaths=/var/lib/liquidity-migration/market-tape-upload /var/lib/liquidity-migration/receipts /var/lib/liquidity-migration/forward-market /var/lib/liquidity-migration/forward-market-binance
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
MemoryMax=1G
TasksMax=128
Nice=15
IOSchedulingClass=idle
