[Unit]
Description=liquidity-migration fast Bybit demo exit risk runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/liquidity-migration
EnvironmentFile=/etc/liquidity-migration/bybit-demo.env
# Per-sleeve kill-switch toggles resolved by deploy/lib_sleeves.sh so ws_risk can
# compute the equal-split IM budget = 1/len(active sleeves). Host overrides can
# turn a repo-on sleeve off, but cannot turn a repo-off sleeve back on.
EnvironmentFile=/etc/liquidity-migration/sleeves.resolved.env
Environment=DATA_ROOT=data/bybit-demo-event
Environment=CONFIG_PATH=configs/volume_alpha.default.yaml
Environment=SUBMIT_ORDERS=1
Environment=CONFIRM_DEMO_ORDERS=1
Environment=TELEGRAM_ENABLED=1
Environment=ORDER_SUBMIT_MODE=ws_then_rest
Environment=REST_FALLBACK=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=REST_RECONCILE_SECONDS=30
Environment=HEARTBEAT_SECONDS=10
Environment=FAST_EXECUTION_STREAM=0
# Combined-book deployment: this single risk service reads all configured
# sleeve/addon ledgers and routes WS fills per the per-row sleeve column. Owner
# picked "extend ws_risk to handle all sides" over running multiple risk processes.
Environment=LONG_DATA_ROOT=data/bybit-long-demo-event
# Continuous-fade sleeve (3rd, also short-direction): this single risk service must ALSO
# read its ledger, else any legacy/future continuous positions look untracked and get
# flattened. Keep wired whenever the continuous sleeve can submit or has live positions.
Environment=CONTINUOUS_DATA_ROOT=data/bybit-continuous-demo-event
# Continuous BTC-beta hedge ledger (WP3): the risk service reads it so the hedge's
# BTC long is tracked (never adopted/flattened); hedge rows carry stop/tp/hold=0 so
# the risk service never force-exits it (the daily hedge manager owns its lifecycle).
Environment=CONTINUOUS_ADDON_DATA_ROOT=data/bybit-continuous-hedge-event
ExecStart=/opt/liquidity-migration/scripts/run_bybit_demo_ws_risk_engine.sh
Restart=always
RestartSec=2
KillMode=control-group
# Bootstrap can take 60-120s on a cold start with a large kline universe.
# 90s default would SIGKILL the daemon if shutdown lands mid-bootstrap.
# Manager now respects shutdown_event, but keep margin for very slow REST.
TimeoutStopSec=180
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/liquidity-migration

[Install]
WantedBy=multi-user.target
