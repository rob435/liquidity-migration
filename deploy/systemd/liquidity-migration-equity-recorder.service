[Unit]
Description=liquidity-migration one equity and recorder sample per minute to disk
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
KillMode=control-group
# Four file reads, four appends, and at most one HTTP POST. A minute timer
# must never find the previous run still activating.
TimeoutStartSec=45
User=liquidity-observer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
# The only unit in the fleet that loads no venue environment at all: it reads
# published artifacts and pushes numbers. Its credential surface is empty by
# construction, which is stronger than unsetting keys it was handed.
EnvironmentFile=-/etc/liquidity-migration/observability.env
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
StateDirectory=liquidity-migration/equity
ReadWritePaths=/var/lib/liquidity-migration/equity
MemoryMax=128M
# An observer must not preempt the signal workers (Nice=5) or owners (Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration/.venv/bin/python scripts/runtime/record_equity.py
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
