[Unit]
Description=liquidity-migration one fleet-health sample per artifact per minute
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
KillMode=control-group
# Six file reads, six appends, and at most one HTTP POST. A minute timer
# must never find the previous run still activating.
TimeoutStartSec=45
User=liquidity-observer
Group=liquidity-migration
WorkingDirectory=/opt/liquidity-migration
# Published artifacts and metrics credentials only; no venue environment.
EnvironmentFile=-/etc/liquidity-migration/observability.env
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
StateDirectory=liquidity-migration/equity
ReadWritePaths=/var/lib/liquidity-migration/equity
MemoryMax=128M
# An observer must not preempt the signal workers (Nice=5) or owners (Nice=-5).
Nice=10
ExecStart=/opt/liquidity-migration-engine/bin/engine-tools record-equity --manifest /opt/liquidity-migration/deploy/fleet_manifest.tsv
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
