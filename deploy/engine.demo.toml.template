# /etc/liquidity-migration/engine.toml  --  root-owned, mode 0600
#
# The engine's config for the FLEET'S DEMO ACCOUNT (555899665). Copy this file
# to the path above on the VPS and edit it there; no deploy writes it.
#
# There is no venue address in here and no way to put one there. `venue` is a
# name that picks one of the adapters compiled into the engine, and every host
# any of them knows is written in one source file which a test reads back.
#
# This is the account the two demo producers publish their books to, and the
# account whose equity they size from -- they read `account_equity_usdt` out of
# the heartbeat below and block every entry when it is missing or stale. So the
# venue, the credential file on the unit, and the two book paths all have to
# name the same account, and nothing checks that agreement for you.

[engine]
venue = "bybit_demo"

wal_path = "/var/lib/liquidity-migration-engine/engine.wal"

# One line of JSON, rewritten every few seconds. Two readers, both load-bearing:
# scripts/runtime/check_fleet_liveness.py pages on stale, unreadable, or
# latched; and BOTH PRODUCERS size from `account_equity_usdt` in it. Leave this
# path out and the producers block every entry, per cycle, quietly.
heartbeat_path = "/var/lib/liquidity-migration-engine/heartbeat.json"

# One line of JSON per position that closes: what it made, what it cost, how
# long it was held. The trade-notify unit reads it and is what puts an exit on
# the owner's phone with its numbers. Leave this path out and exits fall back
# to the target books, which can say a position ended but never what it made.
trades_path = "/var/lib/liquidity-migration-engine/trades.jsonl"

group_flush_ms = 250

# Rotate the log into a fresh segment once the current one passes this many
# megabytes; old segments stay in place as archives, and deleting them is an
# operator decision, never the engine's.
wal_rotate_mb = 256

# How often the engine refreshes its account reading (it refreshes at half
# this). The risk kernel's own staleness bound is [risk] max_account_view_age_s.
account_view_max_age_ms = 5000

# How old the quote an entry was decided against may be before the engine
# refuses to open on it (a symbol with no quote at all is refused the same
# way). Exits always flow, whatever the age.
max_quote_age_ms = 30000

# Who else writes leverage on this account. This engine holds the demo
# account's single mutation lease and nothing else trades it, so what the
# engine set stays trusted across flat spells (entries skip a ~172 ms
# confirmation round trip, measured live 2026-08-18) and every held
# position's leverage is verified against the venue's own position rows
# instead — a mismatch alarms and turns the confirmation back on for that
# symbol. If a hand ever starts trading this account, set "shared".
leverage_authority = "sole"

# ---------------------------------------------------------------------------
# Capital limits
# ---------------------------------------------------------------------------
# The engine loads configs/operational.demo.json itself, so a cap tightened
# there tightens for the producers and the engine at once.
#
# THERE IS NO PER-SLEEVE SHARE. Every sleeve draws on the account-wide caps and
# any one of them can spend the lot; what bounds a loss is the venue-native stop
# on each position.
#
# Nothing else may be written in this block. An [risk.envelope] section or a
# stray `leverage` beside the profile path is refused at boot.
[risk]
operational_profile_path = "/opt/liquidity-migration/configs/operational.demo.json"

# The two numbers the profile does not carry.
disaster_stop_fraction = 0.35
max_account_view_age_s = 120

# ---------------------------------------------------------------------------
# The sleeves
# ---------------------------------------------------------------------------
# Each reads its own book. Books are routed, not broadcast: one reaches its own
# sleeve and no other.
#
# ORDER MATTERS AND IS NOT COSMETIC. A strategy's id is its position in this
# file, and the engine's record of whose position is whose is keyed on that id
# and rebuilt from the log at boot. Putting a new block ahead of `carry` would
# hand carry's whole fill history to whatever took its place. Append; never
# insert.
#
# `symbols` is what each sleeve subscribes to at boot. It is a seed, not a
# ceiling: a name a book mentions that is not listed here is taken on while the
# engine runs. Listing the names each sleeve most often holds only saves the
# admission round trip the first time.
#
# The lists must not overlap -- the engine refuses a config where two
# strategies claim one symbol. If their books later name the same symbol
# anyway, which they can, the engine handles it at run time: whichever sleeve
# is holding the name keeps it, and the other leaves it alone until it is flat.
# That is not a reason to be careless here.

[[strategy]]
name = "target_book"
sleeve = "carry"
book_path = "/var/lib/liquidity-migration/targets/carry-demo.json"
# Rest entries at the touch and let the engine work them in, rather than
# crossing the spread. Carry entries are not urgent and the spread is the
# largest cost they pay.
rest_entries = true
# Two dials on how the resting is worked, both off unless written here. The
# first pins the rest to the price the order was decided at and stops it
# following a market that leaves; the second takes the order down at the end
# of its patience instead of crossing. Together they are "my price or no
# trade". See docs/engine.md §Worked entries for what they cost.
# hold_decision_price = true
# give_up_instead_of_crossing = true
symbols = ["BTCUSDT", "ETHUSDT"]

[[strategy]]
name = "target_book"
sleeve = "long"
book_path = "/var/lib/liquidity-migration/targets/long-demo.json"
# LONG enters on a breakout that has already happened, so a resting entry can
# sit behind a market that has left. It crosses.
rest_entries = false
symbols = ["SOLUSDT", "XRPUSDT"]

[[strategy]]
name = "target_book"
sleeve = "exodus"
# Written by the CARRY producer, not a unit of its own: the sleeve's whole
# trigger is carry's pre-settle exit fire, so it lives in that process
# (lane2_exodus_short_v1). The book holds shorts for ~75 minutes at a time.
book_path = "/var/lib/liquidity-migration/targets/exodus-demo.json"
# Entries cross: the ride is an hour and the measured economics already pay
# the taker fee. Resting a dying name's entry misses the move it exists for.
rest_entries = false
# Seed only; every real name arrives via the book. Must not overlap the
# other sleeves' seeds (see above).
symbols = ["DOGEUSDT"]

