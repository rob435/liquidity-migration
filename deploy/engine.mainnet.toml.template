# /etc/liquidity-migration/engine-mainnet.toml  --  root:liquidity-migration, mode 0640
#
# The engine's config for the FUNDED account. Deployment installs these exact
# reviewed bytes at the path above before activating a funded generation.
#
# There is no venue address in here and no way to put one there. `venue` is a
# name that picks one of the adapters compiled into the engine, and every host
# any of them knows is written in one source file which a test reads back.
# Naming the funded account here is also not permission to trade it: the
# gateway refuses to build unless REAL_MONEY is armed in
# /etc/liquidity-migration/bybit-mainnet.env, by you.

[engine]
# The funded account. The long name is deliberate — this is the string that
# decides whether this process can lose real money, and it should read like it.
venue = "bybit_mainnet"

wal_path = "/var/lib/liquidity-migration-engine-mainnet/engine.wal"

# One line of JSON, rewritten every few seconds, saying when it was written,
# whose account it is on, whether it is still allowed to open
# positions, and what it has seen and sent. scripts/runtime/check_fleet_liveness.py
# reads it and pages on stale, unreadable, or latched.
heartbeat_path = "/var/lib/liquidity-migration-engine-mainnet/heartbeat.json"

# One line of JSON per position that closes: what it made, what it cost, how
# long it was held. The trade-notify unit reads it and is what puts an exit on
# the owner's phone with its numbers.
trades_path = "/var/lib/liquidity-migration-engine-mainnet/trades.jsonl"

# How often buffered log bytes are pushed to the OS. Order records do not wait
# for this — they are forced to disk before the order goes out.
group_flush_ms = 250

# Rotate the log into a fresh segment once the current one passes this many
# megabytes; old segments stay in place as archives, and deleting them is an
# operator decision, never the engine's.
wal_rotate_mb = 256

# How often the engine refreshes its account reading (it refreshes at half
# this). The risk kernel's own staleness bound is [risk] max_account_view_age_s.
account_view_max_age_ms = 5000

# How old the quote an entry was decided against may be before the engine
# refuses to open on it (a symbol with no quote at all is refused the same
# way). Exits always flow, whatever the age.
max_quote_age_ms = 30000

# Keep leverage authority SHARED as a conservative venue-truth check: the
# engine forgets what it set when a symbol goes flat and re-confirms with the
# venue before the next entry. This does not authorize another writer. The
# funded UID contract forbids hand trading, venue bots, copy trading, and other
# trading API keys. (This is also the default when the key is absent.)
leverage_authority = "shared"

# ---------------------------------------------------------------------------
# Capital limits: the fleet's own document, not a copy of its numbers
# ---------------------------------------------------------------------------
# Deployment renders one host profile from the reviewed base and operator
# dials. The producers and engine read that identical artifact, so a cap or
# declared stop change reaches both at once.
#
# Nothing else may be written in this block. An [risk.envelope] section or a
# stray `leverage` is refused, because two documents that both claim to set the
# caps disagree eventually and nobody finds out until it matters.
[risk]
operational_profile_path = "/etc/liquidity-migration/producer-mainnet-source/operational-profile.json"

# The engine-only baseline and account-reading age.
#
# Baseline stop ceiling for sleeves other than carry. If the rendered carry
# declaration is wider, the engine uses that wider value.
disaster_stop_fraction = 0.35
# An account reading older than this is not evidence about the account now.
max_account_view_age_s = 120

# ---------------------------------------------------------------------------
# The three sleeves
# ---------------------------------------------------------------------------
# Each reads its own book. Books are routed, not broadcast: each one reaches its
# own sleeve and no other. That is what stops two followers on one account acting
# on each other's decisions — the venue holds one position per symbol and keeps
# no note of who asked for it.
#
# There is no per-sleeve capital share. All three draw on the account-wide caps
# and any one can spend the lot.
#
# `symbols` is the universe each sleeve starts with. A name a book mentions
# that is not listed here is taken on while the engine runs, so this list is a
# starting point rather than a ceiling — but every name in it is subscribed at
# boot, which is quicker than admitting it later.

[[strategy]]
name = "target_book"
sleeve = "carry"
book_path = "/var/lib/liquidity-migration/targets/carry-mainnet.json"
# Rest entries at the touch and let the engine work them in, rather than
# crossing the spread. Off by default in the plug; on here because carry
# entries are not urgent and the spread is the largest cost they pay.
rest_entries = true
symbols = ["BTCUSDT", "ETHUSDT"]

[[strategy]]
name = "target_book"
sleeve = "long"
book_path = "/var/lib/liquidity-migration/targets/long-mainnet.json"
# LONG is a short-lived breakout signal; crossing while it is fresh matches the
# demo execution policy. Resting it for the generic 120s work window admits a
# materially different, stale entry on the funded account.
rest_entries = false
symbols = ["SOLUSDT", "XRPUSDT"]

[[strategy]]
name = "target_book"
sleeve = "exodus"
# The funded CARRY producer writes this book when its v7 pre-settle exit
# abandons a name. It stays after carry and long because strategy ids follow
# file order and those existing ids must not move.
book_path = "/var/lib/liquidity-migration/targets/exodus-mainnet.json"
# Exodus entries are time-sensitive and their measured economics pay taker
# fees. Covers also cross because the one-hour hold clock is the exit.
rest_entries = false
symbols = ["DOGEUSDT"]

# NOTE ON THE SYMBOL LISTS ABOVE. They are a seed, not a universe. The engine
# takes on any name a book asks for while it runs, so these only save the
# admission round trip for the names each sleeve holds most often -- replacing
# them with the real universes is an optimisation, not a precondition.
#
# The three lists must not overlap: the engine refuses a config where two
# strategies claim one symbol. That check only sees this file, though, and the
# books can name the same symbol hours after boot. The engine handles that at
# run time -- whichever sleeve is holding a name keeps it and the other leaves
# it alone until it is flat -- because the venue's stop belongs to the position
# and two sleeves on one name would have one stop between them.
