# /etc/liquidity-migration/bybit-mainnet.env  --  root-owned, mode 0600
#
# THE EXECUTION FILE YOU EDIT. Copy it to the path above on the VPS, fill in
# the execution credentials, set the dials you care about, and run:
#
#     scripts/ops.sh real-money preflight
#
# which tells you exactly what is still missing.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.
#
# ---------------------------------------------------------------------------
# 1. Credentials and the arming switch
# ---------------------------------------------------------------------------
# Create the key on the FUNDED account with:
#   * contract trading enabled,
#   * WITHDRAWAL DISABLED,
#   * IP-allowlisted to this VPS.
# Rust also requires the venue to report UTA, write access, ContractTrade Order
# and Position, no Wallet Withdraw, and the exact declared host-IP set.
# Replacing an existing key starts with `scripts/ops.sh deploy disarm-mainnet`;
# follow `docs/operations.md` §Funded key rotation and revoke the old key.
# These are deliberately different variable names from the demo pair, so a
# stale demo key can never authenticate a mainnet run.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=
# Exact primary host IP reported in the key's Bybit allowlist. The Rust engine
# refuses a missing value, wildcard, CIDR-all, or any undeclared listed IP.
BYBIT_REAL_API_KEY_IP=
# Optional exact backup host IP. Leave empty for a one-host allowlist. When set,
# Bybit must report exactly the primary and backup addresses and no others.
BYBIT_REAL_API_KEY_BACKUP_IP=
# Account-bound acknowledgement of a venue limitation: Bybit exposes no
# account-wide list API for every grid/DCA/martingale/combo bot family. Set
# this to the exact funded UID only after dedicating that UID to this engine:
# no hand trading, venue bots, copy trading, or other trading API keys.
BYBIT_ENGINE_EXCLUSIVE_ACCOUNT_USER_ID=

# This is the execution-key file. Native takeover and `attest-flat` keep their
# Rust surface read-only even when this is the only installed credential.
# Installing the optional root:root mode-0600
# `/etc/liquidity-migration/bybit-mainnet-attestor.env` makes those controls
# prefer a separate globally read-only key. Never mix the two variable sets.

# The arming switch. Until this is exactly true the mainnet client refuses to
# construct and the owner runner refuses to start.
REAL_MONEY=false

# ---------------------------------------------------------------------------
# 2. The deployment dials in this file
# ---------------------------------------------------------------------------
# Each is a RATIO, never an amount. The account caps and the margin ceilings are
# not dials — they live in configs/operational.mainnet.json and are proved at
# render.
# A retired old RM_ dial left in this file is refused by name at render.
#
# Each line is optional. Omit one and the committed default applies.
# A change takes effect at the next deploy, which re-renders the profile.

# --- sizing is NOT here --------------------------------------------------
# Sleeve multipliers live in configs/operational.mainnet.json. Deployment copies
# that reviewed profile into the public signal-worker source directory and Rust
# renders the same values into the account-owning engine config. No multiplier
# is accepted from this credential file or the signal-worker environment.
#
# The BOOK ceiling is separate again and lives in configs/operational.mainnet.json
# (gross cap = wallet x 5 at entry leverage 5): a book sized past it
# is refused per entry by the engine, never resized. Very high multipliers can
# also exceed some symbols' own venue leverage limits.

# --- protections -----------------------------------------------------------
# Disaster-stop distance on carry entries, armed at the venue with the entry.
# Wide on purpose: the funding-normalisation exit is the intended exit, and
# this only covers the case where nothing local is running.
RM_CARRY_STOP_LOSS_FRACTION=0.35
# Rolling-loss trip: once the engine's own closed trades have lost this share
# of the capital reference, net of venue fees, inside any 24 hours, the engine
# refuses new entries and growth until enough of that loss is older than 24
# hours. Exits always pass. A restart does not clear it.
RM_ROLLING_LOSS_FRACTION=0.10

# ---------------------------------------------------------------------------
# 3. Notifications (optional)
# ---------------------------------------------------------------------------
# Rollout projects these values into a notification-only file for the funded
# liveness observer. The engine removes them from its own environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate chat for watchdog alerts; empty falls back to the main chat.
TELEGRAM_ALERT_CHAT_ID=
