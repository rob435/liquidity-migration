# /etc/liquidity-migration/bybit-mainnet.env  --  root-owned, mode 0600
#
# THE ONE FILE YOU EDIT. Copy it to the path above on the VPS, fill in the
# credentials, set the dials you care about, and run:
#
#     scripts/ops.sh real-money preflight
#
# which tells you exactly what is still missing. Nothing in this repository
# writes this file, sets REAL_MONEY, or starts a mainnet unit. Those are yours.
#
# Format: strict KEY=value, one per line, no inline comments, no quotes, no
# shell expansion. systemd reads it verbatim.
#
# ---------------------------------------------------------------------------
# 1. Credentials and the arming switch
# ---------------------------------------------------------------------------
# Create the key on the FUNDED account with:
#   * contract trading enabled,
#   * WITHDRAWAL DISABLED,
#   * IP-allowlisted to this VPS.
# These are deliberately different variable names from the demo pair, so a
# stale demo key can never authenticate a mainnet run.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=

# The arming switch. Until this is exactly true the mainnet client refuses to
# construct, the owner runner refuses to start, and real-money authority
# refuses to issue. Setting it is the single act that means "trade my money".
REAL_MONEY=false

# ---------------------------------------------------------------------------
# 2. Deployment dials
# ---------------------------------------------------------------------------
# Every dial below is a RATIO, not an amount. The envelope is anchored to
# observed wallet equity (B4), so "how much" is answered by your deposit and
# these answer "in what proportion". Deposit or withdraw freely; nothing here
# goes stale.
#
# These are read by `scripts/ops.sh real-money render-profile`, which writes
# configs/operational.mainnet.json and re-runs the full load-time envelope
# proof. A dial combination that does not prove is refused there, on your
# terminal, rather than at start-up over a funded account. After changing any
# dial you must re-render AND re-issue the authority receipt -- the receipt
# hashes both this file and the rendered profile, which is what stops limits
# from moving without a new authorization.
#
# Every line below is optional. Omit one and the committed default applies.

# --- scale -----------------------------------------------------------------
# Fraction of wallet equity the whole envelope is scaled to. 1.0 = the full
# wallet backs the book. Lower it to hold size below your balance.
RM_EQUITY_FRACTION=1.0
# Reference floor in USDT, so a momentarily unreadable balance cannot produce a
# degenerate envelope. The one dial that is an amount, because a floor has no
# ratio to be a fraction of.
RM_EQUITY_FLOOR_USDT=100.0
# Expansion-only dead band. Equity down rescales the caps immediately; equity
# up waits for a move this large, so ordinary wander cannot re-scale the book
# every cycle.
RM_EXPAND_DEAD_BAND_FRACTION=0.05

# --- leverage --------------------------------------------------------------
# Hard ceiling the owner enforces on every target it accepts.
RM_MAX_LEVERAGE=2.0
# Leverage the producers actually request. Never above RM_MAX_LEVERAGE.
RM_ENTRY_LEVERAGE=2.0

# --- account caps, as ratios of the reference ------------------------------
# Gross notional ceiling as a multiple of the reference. Cannot exceed
# RM_MAX_LEVERAGE: gross above reference x leverage is not reachable within the
# margin the account has.
RM_ACCOUNT_GROSS_MULTIPLE=2.0
# Largest position in one symbol, as a fraction of the reference.
RM_SYMBOL_NOTIONAL_FRACTION=0.5
# Initial-margin ceiling, as a fraction of the reference. At 1.0 the book's
# margin can reach but not exceed the wallet.
RM_INITIAL_MARGIN_FRACTION=1.0
# Daily realised-loss halt, as a fraction of the reference. Trips a flatten.
RM_DAILY_LOSS_FRACTION=0.1

# --- B3 partition: each sleeve's private share of the gross cap -------------
# These must leave room for the token retired-CONTINUOUS share and sum to at
# most 1. Neither sleeve can spend the other's share, which is the whole
# reason both may be funded at once.
RM_CARRY_GROSS_SHARE=0.55
RM_LONG_GROSS_SHARE=0.40

# --- CARRY ------------------------------------------------------------------
RM_CARRY_NOTIONAL_MULTIPLIER=1.0
# Declared disaster-stop distance, armed at the venue with the entry. Wide on
# purpose: the strategy's funding-normalisation exit is meant to be the real
# exit, and this is the seatbelt for when nothing local is running.
RM_CARRY_STOP_LOSS_FRACTION=0.35
RM_CARRY_MAX_NEW_ENTRIES_PER_CYCLE=10

# --- LONG -------------------------------------------------------------------
RM_LONG_NOTIONAL_MULTIPLIER=0.4
RM_LONG_MAX_NEW_ENTRIES_PER_CYCLE=5
RM_LONG_MAX_PROJECTED_INITIAL_MARGIN_PCT_EQUITY=0.5

# ---------------------------------------------------------------------------
# 3. Notifications (optional)
# ---------------------------------------------------------------------------
# The mainnet owner unit sets TELEGRAM_ENABLED=1; supply both or it refuses to
# start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
