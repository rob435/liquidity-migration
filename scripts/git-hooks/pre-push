#!/usr/bin/env bash
# Tracked local Ruff + mypy + pytest gate. Remote CI still runs after push.
# Install it explicitly because .git/hooks is untracked:
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git exports checkout-local variables to hooks. Test fixtures create their own
# repositories, so let each fixture's path select its own .git directory.
while IFS= read -r name; do
    unset "$name"
done < <(git rev-parse --local-env-vars)

echo "[pre-push] repository gate..."
exec "$REPO_ROOT/scripts/dev.sh" check
