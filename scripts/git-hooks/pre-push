#!/usr/bin/env bash
# Tracked local Ruff + mypy + pytest gate. Remote CI still runs after push.
# Install it explicitly because .git/hooks is untracked:
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
REPO_ROOT="$(pwd -P)"

PYTHON_BIN="$REPO_ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON_BIN" ]]; then
    PYTHON_BIN="$(command -v python3 || command -v python)"
fi

echo "[pre-push] ruff check..."
"$PYTHON_BIN" -m ruff check liquidity_migration tests scripts

echo "[pre-push] mypy..."
"$PYTHON_BIN" -m mypy liquidity_migration

PYTEST_BASETEMP="${PYTEST_BASETEMP:-}"
if [[ -z "$PYTEST_BASETEMP" ]]; then
    PYTEST_TMP_ROOT="${TMPDIR:-/tmp}"
    mkdir -p "$PYTEST_TMP_ROOT"
    PYTEST_TMP_ROOT="$(cd "$PYTEST_TMP_ROOT" && pwd -P)"
    PYTEST_BASETEMP="$PYTEST_TMP_ROOT/liquidity-migration-pytest-pre-push-$(date +%Y%m%d%H%M%S)-$$"
fi

PYTEST_BASETEMP_PARENT="$(dirname "$PYTEST_BASETEMP")"
mkdir -p "$PYTEST_BASETEMP_PARENT"
PYTEST_BASETEMP_PARENT="$(cd "$PYTEST_BASETEMP_PARENT" && pwd -P)"
PYTEST_BASETEMP="$PYTEST_BASETEMP_PARENT/$(basename "$PYTEST_BASETEMP")"
mkdir -p "$PYTEST_BASETEMP"
PYTEST_BASETEMP="$(cd "$PYTEST_BASETEMP" && pwd -P)"
case "$PYTEST_BASETEMP" in
    "$REPO_ROOT"|"$REPO_ROOT"/*)
        echo "[pre-push] refusing pytest basetemp inside repository: $PYTEST_BASETEMP" >&2
        exit 1
        ;;
esac

echo "[pre-push] pytest -q (basetemp=$PYTEST_BASETEMP)..."
"$PYTHON_BIN" -m pytest -q --basetemp "$PYTEST_BASETEMP"

echo "[pre-push] OK — pushing."
