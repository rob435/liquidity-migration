    "per_symbol_features": [
      {
        "name": "ret1",
        "formula": "close / lag(close,1) - 1"
      },
      {
        "name": "ret72",
        "formula": "close / lag(close,72) - 1"
      },
      {
        "name": "ret168",
        "formula": "close / lag(close,168) - 1"
      },
      {
        "name": "rv_168h",
        "formula": "rolling_sample_std(ret1,window=168,min_finite=48)"
      },
      {
        "name": "max_ret168",
        "formula": "rolling_max(ret1,window=168,min_finite=48,includes_current=true)"
      },
      {
        "name": "prior_max_ret168_lag1",
        "formula": "rolling_max(lag(ret1,1),window=168,min_finite=48)"
      },
      {
        "name": "min720",
        "formula": "rolling_min(close,window=720,min_finite=168)"
      },
      {
        "name": "max720",
        "formula": "rolling_max(close,window=720,min_finite=168)"
      },
      {
        "name": "vov",
        "formula": "rolling_sample_std(rv_168h,window=720,min_finite=168)"
      },
      {
        "name": "dist_low",
        "formula": "(close-min720)/(max720-min720)",
        "null_when": "max720<=min720"
      },
      {
        "name": "prior6_ret1_max",
        "formula": "rolling_max(lag(ret1,1),window=6,min_finite=1)"
      },
      {
        "name": "prior6_close_max",
        "formula": "rolling_max(lag(close,1),window=6,min_finite=1)"
      },
      {
        "name": "giveback_from_prior6_high",
        "formula": "close/prior6_close_max-1"
      },
      {
        "name": "prior168_turnover_mean",
        "formula": "rolling_mean(lag(turnover_quote,1),window=168,min_finite=48)"
      },
      {
        "name": "prior168_turnover_std",
        "formula": "rolling_sample_std(lag(turnover_quote,1),window=168,min_finite=48)"
      },
      {
        "name": "turnover_24h",
        "formula": "rolling_sum(turnover_quote,window=24,min_finite=6)"
      },
      {
        "name": "turnover_spike_168h",
        "formula": "turnover_quote/prior168_turnover_mean"
      },
      {
        "name": "turnover_zscore_168h",
        "formula": "(turnover_quote-prior168_turnover_mean)/prior168_turnover_std",
        "null_when": "prior168_turnover_std<=0"
      }
    ],
