    "causal_feature_formulas": {
      "daily_bar": {
        "utc_aggregation": {
          "open": "first_hourly_open",
          "high": "maximum_hourly_high",
          "low": "minimum_hourly_low",
          "close": "last_hourly_close",
          "turnover_quote": "sum_hourly_turnover"
        },
        "minimum_hourly_bars": 20,
        "timestamp": "following_UTC_midnight"
      },
      "log_return": "log(close)-log(close_on_prior_calendar_day)",
      "simple_return_1d": "exp(log_return)-1",
      "pump_3d_log": "log(close/close_three_calendar_days_earlier)",
      "simple_return_3d": "exp(pump_3d_log)-1",
      "pump_7d_log": "log(close/close_seven_calendar_days_earlier)",
      "simple_return_7d": "exp(pump_7d_log)-1",
      "intra_max_Nh_pump_log": {
        "N_hours": 6,
        "hourly_formula": "log(close/close_exactly_6_hours_earlier)",
        "daily_formula": "maximum_within_symbol_and_UTC_signal_day",
        "latest_allowed_bar_end": "signal_ts_ms"
      },
      "close_location": {
        "formula": "(close-low)/(high-low)",
        "fallback": 0.5,
        "fallback_when": "high-low<=1e-12"
      },
      "close_loc_3d": {
        "formula": "(close-rolling_3_calendar_day_min_low)/(rolling_3_calendar_day_max_high-rolling_3_calendar_day_min_low)",
        "minimum_daily_observations": 3,
        "fallback": 0.5
      },
      "close_loc_7d": {
        "formula": "(close-rolling_7_calendar_day_min_low)/(rolling_7_calendar_day_max_high-rolling_7_calendar_day_min_low)",
        "minimum_daily_observations": 7,
        "fallback": 0.5
      },
      "realized_vol": "rolling_calendar_sample_std(log_return,30,min=30)*sqrt(365)",
      "sigma_daily_30d": "realized_vol/sqrt(365)",
      "turnover_median_90d": "rolling_calendar_median(turnover_quote,90,min=90)",
      "today_volume_rank": "ordinal_descending_rank(turnover_quote)_within_signal_ts",
      "universe_rank": "ordinal_descending_rank(turnover_median_90d)_within_signal_ts",
      "symbol_age_days": "calendar_days_since_first_daily_row_under_loaded_root_plus_1",
      "in_universe": "universe_rank<=50 and symbol_age_days>=30 and finite(turnover_median_90d)",
      "true_range": "max(high-low,abs(high-prior_calendar_close),abs(low-prior_calendar_close))",
      "atr_14d_pct": "rolling_calendar_mean(true_range,14,min=7)/close",
      "turnover_median_30d": "rolling_calendar_median(turnover_quote,30,min=15)",
      "vol_vs_30d_median": "turnover_quote/turnover_median_30d",
      "coin_30d_return": "close/close_30_calendar_days_earlier-1",
      "coin_60d_return": "close/close_60_calendar_days_earlier-1",
      "btc_regime_on": "BTC_close>BTC_30_calendar_day_simple_moving_average",
      "eth_regime_on": "ETH_close>ETH_30_calendar_day_simple_moving_average",
      "btc_sma_dist": "BTC_close/BTC_30_calendar_day_simple_moving_average-1",
      "eth_sma_dist": "ETH_close/ETH_30_calendar_day_simple_moving_average-1"
    },
    "rank_semantics": {
      "today_volume_rank": "ordinal_descending_exact_source",
      "universe_rank": "ordinal_descending_exact_source",
      "diagnostic_peer_counts_change_production_rank": false
